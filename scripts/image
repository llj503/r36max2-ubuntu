#!/bin/bash

# SPDX-License-Identifier: GPL-2.0-or-later
# scripts/image - assemble the r36max2 .img.xz from ${BUILD}.
#
# Ported from the v20 pack-v20.sh with the non-determinism removed:
#   * fixed FAT volume id + ext4 UUID (distributions/rk3326/options)
#   * /etc/r36max2-build-info carries SOURCE_DATE_EPOCH, not wall clock
#   * lazy_itable_init off so the ext4 metadata is fully written at mkfs time
#   * xz -T1 (single thread; -T0 output depends on host core count)
#   * vendor blobs verified against sources/vendor-blobs.sha256
#
# The verification gate from v20 is kept and extended: module vermagic per
# kernel, dtb gpio polarity flags, weston present-but-not-enabled, zero SSH
# host keys, empty machine-id, no wpa credentials, dpkg manifest present.
# Any failure exits nonzero BEFORE compression.


# root helper: passwordless sudo if available; otherwise WSL2's root session
# (wsl.exe -u root needs no password and shares this filesystem)
if command -v wsl.exe >/dev/null 2>&1 && ! sudo -n true 2>/dev/null; then
  SUDO() { wsl.exe -u root -- "$@"; }
else
  SUDO() { sudo "$@"; }
fi

. config/options ""

IMG_V="${IMG_V:-${DISTRO_VERSION}}"
IMG="${TARGET_IMG}/r36max2-ubuntu-${IMG_V}.img"
VENDOR="${ROOT}/sources/vendor"
BLOBS_SUMS="${ROOT}/sources/vendor-blobs.sha256"
MNT="${BUILD}/.mount"
KVER="$(get_pkg_variable linux PKG_VERSION)"

LINUX_INSTALL="$(get_install_dir linux)"
INITRAMFS_INSTALL="$(get_install_dir initramfs)"
FW_INSTALL="$(get_install_dir aic8800-dc-fw)"

echo "=== [1] tidy the staging tree so rsync sees empty /proc /sys /dev ==="
R="${BUILD}/image/system"
[ -d "${R}/usr/bin" ] || die "image: staging tree missing - build the image package first"
for m in proc sys dev/pts dev/shm; do
  mountpoint -q "${R}/$m" && SUDO umount -l "${R}/$m" 2>/dev/null || true
done
find "${R}/proc" "${R}/sys" -mindepth 1 -delete 2>/dev/null || true
find "${R}/dev" -mindepth 1 -not -path "${R}/dev/null" -delete 2>/dev/null || true
rm -rf "${R}/run/"* "${R}/tmp/"* 2>/dev/null || true
# modules_install leaves build/source symlinks into the multi-GB kernel tree;
# shipping them means a dangling symlink on every card
for kv in "${R}"/lib/modules/*; do rm -f "${kv}/build" "${kv}/source" 2>/dev/null || true; done

# depmod has to run over the MERGED tree.  modules.dep is generated by the linux
# package's own modules_install, at which point lib/modules/<kver>/extra/ does not
# exist yet - aic8800 and the joypad driver are separate packages whose .ko files
# are only copied in by the install merge.  So modprobe could not find any of them:
# the first v21 boot logged "systemd-modules-load: Failed to find module
# 'aic8800_fdrv'/'aic_load_fw'" and came up with no wlan0 and no joystick, while
# every .ko was demonstrably on the card and the old check only asked whether
# modules.dep existed - which it did.
# Ubuntu is merged-usr: /lib is a symlink to usr/lib, and every wants link the
# distro's own postinsts wrote says /lib/systemd/system/<unit>.  The staging tree
# grew a REAL /lib here (the kernel and wifi packages install lib/modules and
# lib/firmware), which silently broke fifteen of those links - among them
# ssh.service and ssh.socket, so the board would have had no SSH on first boot and
# systemd would have logged fifteen not-found units.  Put the layout back.
if [ -d "${R}/lib" ] && [ ! -L "${R}/lib" ]; then
  for d in modules firmware; do
    [ -d "${R}/lib/${d}" ] || continue
    if [ -e "${R}/usr/lib/${d}" ]; then
      # both exist: a previous pack already moved this under usr/lib, and the merge
      # tar recreated a real /lib on top of the symlink.  A plain `mv` would drop it
      # in as usr/lib/modules/modules and the kernel would boot with no modules at
      # all, so merge the contents instead.
      SUDO cp -a "${R}/lib/${d}/." "${R}/usr/lib/${d}/" ||
        die "image: cannot merge /lib/${d} into usr/lib/${d}"
      SUDO rm -rf "${R}/lib/${d}"
    else
      SUDO mv "${R}/lib/${d}" "${R}/usr/lib/" || die "image: cannot move /lib/${d} under usr/lib"
    fi
  done
  SUDO rmdir "${R}/lib" 2>/dev/null || { ls -A "${R}/lib" 2>/dev/null | sed 's/^/      leftover: /'; die "image: /lib still holds something - refusing to replace it with a symlink"; }
  SUDO ln -sfn usr/lib "${R}/lib"
fi

# depmod has to run over the MERGED tree, and *after* the merged-usr repair above.
# modules.dep is generated by the linux package's own modules_install, at which point
# lib/modules/<kver>/extra/ does not exist yet - aic8800 and the joypad driver are
# separate packages whose .ko files are only copied in by the install merge.  So
# modprobe could not find any of them: the first v21 boot logged "systemd-modules-load:
# Failed to find module 'aic8800_fdrv'/'aic_load_fw'" and came up with no wlan0 and no
# joystick, while every .ko was demonstrably on the card and the old check only asked
# whether modules.dep existed - which it did.
#
# Running it before the repair is what broke the rebuild after a kernel-only change:
# the fresh modules_install recreates a real ${R}/lib/modules/<kver> that has no
# extra/, depmod resolves /lib/modules under the root it is given, indexes that
# incomplete tree, and writes its modules.dep there.  The assertion then reads the
# usr/lib copy and dies - correctly, but for a reason the message did not name.
KV="${KVER}"
[ -n "${KV}" ] || KV=$(ls "${R}/usr/lib/modules" | head -1)
if [ -d "${R}/usr/lib/modules/${KV}" ]; then
  SUDO depmod -b "${R}" -a "${KV}" || die "image: depmod failed for ${KV}"
  for m in aic8800_fdrv aic_load_fw rocknix-singleadc-joypad; do
    SUDO grep -q "extra/${m}.ko" "${R}/usr/lib/modules/${KV}/modules.dep" ||
      die "image: modules.dep still does not list ${m}.ko after depmod"
  done
  echo "  depmod over the merged tree: $(SUDO grep -c 'extra/.*\.ko' "${R}/usr/lib/modules/${KV}/modules.dep") extra modules listed"
fi

# Now sweep unit links that are broken *inside the image*.  A wants link to a unit
# that does not exist is a not-found unit at boot, and Ubuntu 26.04 ships no
# sshd-keygen.service while four *.wants/ directories still reference it.
# Links to /dev/null are systemd's masking idiom and are left alone.
swept=0
for l in $(find "${R}/etc/systemd/system" "${R}/usr/lib/systemd/system" -maxdepth 2 -type l 2>/dev/null); do
  t=$(readlink "${l}")
  [ "${t}" = "/dev/null" ] && continue
  case "${t}" in
    /*) [ -e "${R}${t}" ] && continue ;;
    *)  [ -e "$(dirname "${l}")/${t}" ] && continue ;;
  esac
  echo "      removing broken unit link: ${l#${R}/} -> ${t}"
  SUDO rm -f "${l}" && swept=$((swept + 1))
done
if [ -L "${R}/lib" ]; then
  echo "  merged-usr /lib -> $(readlink "${R}/lib")"
else
  # hard stop, not fail=1: the shared flag is initialised to 0 much later (in [6]),
  # which would silently erase an assertion set here.
  echo "  /lib is STILL A DIRECTORY - the merged-usr symlink was not established"
  die "image: /lib must be a symlink to usr/lib, or fifteen unit links break on the card"
fi
echo "  broken unit links removed: ${swept}"
echo "  rootfs size: $(SUDO du -sh "${R}" | cut -f1)"
echo "  free: $(df -h . | tail -1 | awk '{print $4}')"

# Measure before formatting, not after the rsync fails with ENOSPC halfway through.
# The first framework run came out 2658 MiB against a 2 GiB partition and the packing
# step died mid-copy with a message about the filesystem, not about the plan.
# du has to run with SUDO: the apt layer hands the tree back to root on purpose, so an
# unprivileged du silently skips 0700 directories (/root, /var/log/private, ...) and
# reported 1457 MiB while warning about eleven directories it could not read.
root_kb=$(( $((${SYSTEM_SIZE_SECTORS})) * 512 / 1024 ))
need_kb=$(SUDO du -sk --exclude="${R}/proc" --exclude="${R}/sys" --exclude="${R}/dev" "${R}" | cut -f1)
echo "  root partition: $((root_kb/1024)) MiB, staging rootfs: $((need_kb/1024)) MiB"
[ "${need_kb}" -lt "${root_kb}" ] || die "image: rootfs needs $((need_kb/1024)) MiB but SYSTEM_SIZE_SECTORS gives $((root_kb/1024)) MiB - raise it in distributions/${PROJECT}/options (and say so in the release notes)"
free_mb=$(( (root_kb - need_kb) / 1024 ))
echo "  fits with ${free_mb} MiB spare"
[ "${free_mb}" -gt 64 ] || echo "  !! less than 64 MiB spare - first-boot growth (logs, apt cache) will be tight"

echo "=== [2] vendor u-boot blobs ==="
for b in idbloader.img uboot.img trust.img; do
  [ -f "${VENDOR}/${b}" ] || die "image: ${VENDOR}/${b} missing - run scripts/extract-vendor-blobs.sh (see BUILD.md)"
done
if [ -f "${BLOBS_SUMS}" ]; then
  ( cd "${VENDOR}" && sha256sum -c "${BLOBS_SUMS}" ) || die "image: vendor blob checksum mismatch"
  echo "  blobs verified against sources/vendor-blobs.sha256"
else
  ( cd "${VENDOR}" && sha256sum idbloader.img uboot.img trust.img ) > "${BLOBS_SUMS}"
  echo "  recorded ${BLOBS_SUMS} (first run; enforce on every later run)"
fi

echo "=== [3] partition + filesystems ==="
BOOT_SECTORS="$((${BOOT_SIZE_SECTORS}))"
ROOT_SECTORS="$((${SYSTEM_SIZE_SECTORS}))"
IMG_SECTORS=$((262144 + ROOT_SECTORS))
P2SECTORS=${ROOT_SECTORS}
SUDO losetup -D 2>/dev/null || true
mkdir -p "${TARGET_IMG}" "${MNT}/boot" "${MNT}/root"
rm -f "${IMG}"
truncate -s "$((IMG_SECTORS*512))" "${IMG}"
printf 'label: dos\nunit: sectors\n\nstart=%s, size=%s, type=c, bootable\nstart=%s, size=%s, type=83\n' \
  "${BOOT_START_SECTOR}" "${BOOT_SIZE_SECTORS}" "${SYSTEM_START_SECTOR}" "${P2SECTORS}" \
  | SUDO sfdisk -q "${IMG}"
SUDO dd if="${VENDOR}/idbloader.img" of="${IMG}" bs=512 seek=${BLOB_IDBLOADER_SECTOR} conv=notrunc,fsync status=none
SUDO dd if="${VENDOR}/uboot.img"     of="${IMG}" bs=512 seek=${BLOB_UBOOT_SECTOR}     conv=notrunc,fsync status=none
SUDO dd if="${VENDOR}/trust.img"     of="${IMG}" bs=512 seek=${BLOB_TRUST_SECTOR}     conv=notrunc,fsync status=none
SUDO losetup -P -f "${IMG}"
LOOP=$(SUDO losetup -j "${IMG}" | cut -d: -f1)
echo "  loop=${LOOP}"
for i in 1 2; do for _ in $(seq 1 40); do [ -b "${LOOP}p$i" ] && break; sleep 0.4; done; done
# fixed volume identity + fully-initialized inode tables (deterministic)
SUDO mkfs.vfat -F 32 -n "${BOOT_LABEL}" -i "${BOOT_VOLUME_ID#0x}" "${LOOP}p1" >/dev/null
SUDO mkfs.ext4 -q -L "${SYSTEM_LABEL}" -U "${SYSTEM_UUID}" -m 1 \
  -E lazy_itable_init=0,lazy_journal_init=0 "${LOOP}p2"
SUDO mount "${LOOP}p1" "${MNT}/boot"
SUDO mount "${LOOP}p2" "${MNT}/root"

echo "=== [4] FAT: kernel, uInitrd, dtbs, boot.ini variants ==="
SUDO cp "${LINUX_INSTALL}/.image/Image" "${LINUX_INSTALL}/.image/"rk3326-xifan-r36max2*.dtb "${MNT}/boot/"
SUDO cp "${INITRAMFS_INSTALL}/.image/uInitrd" "${MNT}/boot/"
SUDO cp "${FW_INSTALL}/lib/firmware/aic8800DC/"* "${MNT}/root/" 2>/dev/null || true

make_bootini() {   # $1=dtb  $2=output
  cat <<INI | SUDO tee "$2" >/dev/null
odroidgoa-uboot-config

setenv bootargs "rootwait rw net.ifnames=0 fbcon=rotate:0 console=tty0 loglevel=5 systemd.show_status=1"

if test -e mmc 1:1 rescue; then
  setenv bootargs "\${bootargs} systemd.unit=rescue.target"
  echo "r36max2: RESCUE mode"
fi

setenv loadaddr "0x02000000"
setenv initrd_loadaddr "0x01100000"
setenv dtb_loadaddr "0x01f00000"

load mmc 1:1 \${loadaddr} Image
load mmc 1:1 \${initrd_loadaddr} uInitrd
load mmc 1:1 \${dtb_loadaddr} $1

booti \${loadaddr} \${initrd_loadaddr} \${dtb_loadaddr}
INI
}
make_bootini "rk3326-xifan-r36max2.dtb"         "${MNT}/boot/boot.ini"
make_bootini "rk3326-xifan-r36max2-usbhost.dtb" "${MNT}/boot/boot-usbhost.ini"
for f in boot.ini boot-usbhost.ini; do
  echo "  $(printf '%-18s' $f) $(SUDO grep -oE 'Image[^ ]*|rk3326[^ ]*dtb' "${MNT}/boot/$f" | tr '\n' ' ')"
done
SUDO grep -q '{dtb}' "${MNT}/boot/boot.ini" && { echo "!! boot.ini uses a variable filename"; exit 1; }

cat <<'TXT' | SUDO tee "${MNT}/boot/r36-switches.txt" >/dev/null
r36max2 Ubuntu - 这张 BOOT 分区上的开关

  wifi.txt      换网络 / 换人用这块板子：新建文本文件 wifi.txt，两行
                    SSID=你的WiFi名
                    PSK=你的密码
                （可选第三行 COUNTRY=CN）。开机 30 秒内、以及之后每分钟检查一次，
                内容变了就自动写进 wpa_supplicant 并重连，不用重刷。
                结果写回 wifi-status.txt：连上会给出 IP，连不上会列出附近热点。
                **镜像里不带任何 WiFi 凭据**，不放这个文件就只有 SSH 有线路径可走。
                注意这块板子只能 2.4GHz + WPA2（见 HARDWARE.md）。
                参考 wifi-example.txt（改名去掉 -example 即可生效）。
  rescue        新建同名空文件 -> 以 rescue.target 启动
  noscreen      新建同名空文件 -> 关掉屏幕上的状态页（刷屏或黑屏时用这个自救）
  r36-log       新建同名空文件 -> 立刻再写一份状态报告到 r36-boot.txt
  usbhost       想用第二组 USB 主机控制器（试 Type-C 插键盘）：把 boot-usbhost.ini
                改名成 boot.ini 覆盖掉即可，先备份原来那份
  fw\aic8800DC  一套备用的 AIC WiFi 固件。要改用它们：新建空文件
                use-boot-fw，开机会把内核固件搜索路径指到这里并重载 WiFi 驱动

  图形（weston / 摇杆键鼠桥）装在系统里但**默认不启动**。SSH 进去：
      r36-wayland start        # 起 weston，键鼠桥跟着起（BindsTo）
      r36-wayland status       # 看合成器与摇杆桥的状态
      systemctl stop weston    # 回文字控制台
  注意：长时间跑 weston 后这块 VOP 可能丢翻页完成中断（屏幕冻在最后一帧）。

  每次开机 40 秒后（之后每 2 分钟）设备把完整状态写到 r36-boot.txt。
  u-boot 启动失败时自己会往这个分区写 error.log —— 黑屏就先看它。
  镜像里不带 WiFi 凭据，也不带 SSH 主机密钥（首次开机 ssh-keygen -A 生成）；
  默认账号 ubuntu / 密码 ubuntu，**刷完第一件事就是 passwd 改掉**。
TXT
cat <<'EXM' | SUDO tee "${MNT}/boot/wifi-example.txt" >/dev/null
SSID=my-wifi-name
PSK=my-passphrase-at-least-8-chars
COUNTRY=CN
EXM
SUDO mkdir -p "${MNT}/boot/fw/aic8800DC"
SUDO cp "${FW_INSTALL}/lib/firmware/aic8800DC/"* "${MNT}/boot/fw/aic8800DC/" 2>/dev/null || true

SUDO mkdir -p "${MNT}/boot/extlinux"
cat <<ELX | SUDO tee "${MNT}/boot/extlinux/extlinux.conf" >/dev/null
LABEL Ubuntu
  LINUX /Image
  INITRD /uInitrd
  FDT /rk3326-xifan-r36max2.dtb
  APPEND rootwait rw net.ifnames=0 fbcon=rotate:0 console=tty0 loglevel=5 systemd.show_status=1
ELX

echo "=== [5] copy the rootfs ==="
SUDO rsync -aHAX --numeric-ids \
  --exclude='/proc/*' --exclude='/sys/*' --exclude='/dev/*' \
  "${R}/" "${MNT}/root/"
SUDO mkdir -p "${MNT}/root/proc" "${MNT}/root/sys" "${MNT}/root/dev/pts" "${MNT}/root/dev/shm" "${MNT}/root/run" "${MNT}/root/boot"
for n in "null c 1 3 666" "zero c 1 5 666" "random c 1 8 666" "urandom c 1 9 666" "console c 5 1 600"; do
  set -- $n
  SUDO mknod -m "$3" "${MNT}/root/dev/$1" "$2" "$4" "$5" 2>/dev/null || true
done
SUDO rm -f "${MNT}/root/etc/systemd/system/network-online.target.wants/systemd-networkd-wait-online.service"
# Two ownership facts the build gets wrong on its own, both measured on hardware
# after booting the packed image: the filesystem's top directory came out owned by
# the build user (uid 1000, which is *ubuntu* in this image, so / was owned by the
# unprivileged account and tmpfiles logged "unsafe path transition / (owned by
# ubuntu)" on every boot), and useradd's home directory was re-owned to root by
# rootfs-apt's closing "chown -R root:root", leaving ubuntu unable to read its own
# $HOME (login then spammed Permission denied from ~/.bashrc and the user generator).
SUDO chown root:root "${MNT}/root"
SUDO chmod 0755 "${MNT}/root"
ug=$(SUDO awk -F: '$1=="ubuntu"{print $3":"$4}' "${MNT}/root/etc/passwd")
if [ -n "${ug}" ]; then
  SUDO chown -R "${ug}" "${MNT}/root/home/ubuntu"
  SUDO chmod 0750 "${MNT}/root/home/ubuntu"
else
  v "  !! no ubuntu account in the packed rootfs - \$HOME ownership not fixed"
fi
# deterministic build info: SOURCE_DATE_EPOCH, not wall clock
echo "kernel=${KVER} base=ubuntu-${OS_VERSION} apt-snapshot=${APT_SNAPSHOT} epoch=${SOURCE_DATE_EPOCH} wayland=installed-not-enabled credentials=none" \
  | SUDO tee "${MNT}/root/etc/r36max2-build-info" >/dev/null
# the initramfs identifies the rootfs by exactly this file: no marker means it scans
# every block device for twenty seconds and then drops to a shell inside the initrd
SUDO test -s "${MNT}/root/etc/r36max2-build-info" ||
  die "image: /etc/r36max2-build-info missing - the initramfs could not find this rootfs"
[ -s "${MNT}/root/etc/machine-id" ] || SUDO truncate -s 0 "${MNT}/root/etc/machine-id"
sync
df -h "${LOOP}p2" | tail -1 | awk '{print "  root partition: size="$2" used="$3" avail="$4" use%="$5}'

echo "=== [6] verify what actually landed in the image ==="
fail=0
v() { echo "  $*"; }
n=$(SUDO find "${MNT}/root/lib/modules/${KVER}" -name '*.ko' 2>/dev/null | wc -l)
v "/lib/modules/${KVER}: $n .ko"
[ "$n" -gt 50 ] || { v "    !! too few modules"; fail=1; }
[ -e "${MNT}/root/lib/modules/${KVER}/modules.dep" ] || { v "    !! no modules.dep (depmod missing)"; fail=1; }
[ -e "${MNT}/root/lib/modules/${KVER}/build" ] && { v "    !! build symlink survived"; fail=1; }
for m in aic8800_fdrv aic_load_fw rocknix-singleadc-joypad; do
  f="${MNT}/root/lib/modules/${KVER}/extra/$m.ko"
  if SUDO [ -e "$f" ]; then
    vv=$(SUDO modinfo -F vermagic "$f" 2>/dev/null | awk '{print $1}')
    v "    extra/$m.ko -> vermagic $vv"
    [ "$vv" = "${KVER}" ] || { v "      !! wrong kernel"; fail=1; }
  else
    v "    !! missing extra/$m.ko"; fail=1
  fi
done
v "weston: $(SUDO ls "${MNT}/root/usr/bin/weston" 2>/dev/null || echo MISSING)"
if SUDO ls "${MNT}/root/etc/systemd/system/multi-user.target.wants/weston.service" >/dev/null 2>&1; then
  v "  !! weston IS enabled (must be opt-in)"; fail=1
else
  v "  weston enabled? no (correct)"
fi
hk=$(SUDO ls "${MNT}/root/etc/ssh/ssh_host_"* 2>/dev/null | wc -l)
v "ssh host keys in image: $hk (must be 0)"
[ "$hk" = 0 ] || fail=1
SUDO ls "${MNT}/root/etc/systemd/system/multi-user.target.wants/r36-hostkeys.service" >/dev/null 2>&1 \
  || SUDO ls "${MNT}/root/usr/lib/systemd/system/multi-user.target.wants/r36-hostkeys.service" >/dev/null 2>&1 \
  || { v "  !! host-key regen unit not enabled"; fail=1; }
v "machine-id: $([ -s "${MNT}/root/etc/machine-id" ] && echo NON-EMPTY || echo empty)"
[ -s "${MNT}/root/etc/machine-id" ] && fail=1
v "wpa configs with creds: $(SUDO grep -l '^psk=' "${MNT}/root/etc/wpa_supplicant/"*wlan0.conf 2>/dev/null | wc -l) (must be 0)"
SUDO grep -q '^psk=' "${MNT}/root/etc/wpa_supplicant/"*wlan0.conf 2>/dev/null && fail=1
nl=$(SUDO wc -l < "${MNT}/root/etc/r36max2/dpkg-manifest.txt" 2>/dev/null || echo 0)
[ "${nl}" -gt 100 ] \
  || { v "  !! dpkg manifest has ${nl} lines - the package db did not survive the root session (escapes eaten in transit?)"; fail=1; }
v "  dpkg manifest: ${nl} packages"
v "modules-load.d: $(SUDO tr '\n' ' ' < "${MNT}/root/etc/modules-load.d/r36max2.conf")"
# Ownership of these two directories is not something the build reaches correctly -
# see the fix in step [5] - and both were only visible once the image was running.
v "/ owner: $(SUDO stat -c '%U:%G %a' "${MNT}/root") (must be root:root 755)"
[ "$(SUDO stat -c '%u:%g' "${MNT}/root")" = "0:0" ] || fail=1
h_owner=$(SUDO stat -c '%u:%g' "${MNT}/root/home/ubuntu" 2>/dev/null || echo none)
want=$(SUDO awk -F: '$1=="ubuntu"{print $3":"$4}' "${MNT}/root/etc/passwd")
v "/home/ubuntu owner: ${h_owner} (must be ${want}, the account's own uid:gid)"
[ "${h_owner}" = "${want}" ] || fail=1
for d in "${MNT}/boot/rk3326-xifan-r36max2.dtb"; do
  v "FAT $(basename $d) gpio flags: $(SUDO dtc -I dtb -O dts "$d" 2>/dev/null | grep -E 'rumble-gpio|amux-a-gpios' | tr -s ' \t' ' ' | tr '\n' ' ')"
  # Two properties the board cannot work without, asserted against the dtb that is
  # actually in the image rather than against the source file: without dr_mode="host"
  # dwc2 never starts its hcd, so it never enables vbus_wifi and the AIC8800DC does not
  # enumerate for the entire boot; without regulator-always-on the module's power is
  # owned by a controller reference count.  Both live only in projects/RK3326/dt/, so a
  # silently skipped kernel package (stamp not invalidated) would ship the old dtb and
  # the only symptom would be "no wlan0" on hardware with no console.
  DTB_DTS=$(SUDO dtc -I dtb -O dts "$d" 2>/dev/null)
  echo "$DTB_DTS" | awk '/usb@ff300000/{f=1} f && /dr_mode = "host"/{ok=1} f && /^\t\t\};/{f=0} END{exit !ok}' \
    || die "$(basename $d): usb@ff300000 is not dr_mode=\"host\" - the WiFi module would never enumerate"
  echo "$DTB_DTS" | awk '/vbus_wifi/{f=1} f && /regulator-always-on/{ok=1} f && /^\t\t\};/{f=0} END{exit !ok}' \
    || die "$(basename $d): vbus_wifi has no regulator-always-on - a controller could drop the module's power"
  # vbus_host is the u2phy otg-port's ext-supply.  Left switchable, the port dropped
  # its reference 33.7 s into a boot and the AIC firmware stopped answering 7 s later,
  # latching the driver's command queue into CRASHED for the rest of the run while the
  # lease and the USB device both stayed visible - so the symptom was "connected but
  # nothing works", which no log line on the host would explain.
  echo "$DTB_DTS" | awk '
      !f && /^[ \t]*vbus_host[ \t]*\{/ { f=1; ind=$0; sub(/vbus_host.*$/, "", ind); next }
      f && $0 ~ /^\t*regulator-always-on;/ { ok=1 }
      f && $0 == ind"};" { f=0 }
      END { exit !ok }' \
    || die "$(basename $d): vbus_host has no regulator-always-on - the otg-port can power the WiFi module off mid-boot"
done

# --- the three assertions the v20 card had to teach the hard way --------------
# 1. every unit a package enables must be enabled somewhere systemd looks, and no
#    wants symlink may dangle.  Two v20 lessons: wifi-setup's files were on disk but
#    in no *.wants/ directory, so systemd never ran them - and the only symptom was
#    that r36-boot.txt never mentioned them, which proves nothing, because that
#    service list never included them.  Absence from a log is not evidence: presence
#    is asserted here.  rootfs-apt meanwhile linked r36-audio.service, a unit nobody
#    ships, i.e. a dangling wants symlink -> a not-found unit at boot.
units_ok=1
for want in multi-user.target.wants/r36-wifi-setup.service \
            multi-user.target.wants/r36-wpa@wlan0.service \
            multi-user.target.wants/r36-status-screen.service \
            multi-user.target.wants/r36-resize-root.service \
            multi-user.target.wants/r36-expand-root.service \
            multi-user.target.wants/r36-fwswap.service \
            multi-user.target.wants/r36-hostkeys.service \
            multi-user.target.wants/audio.service \
            multi-user.target.wants/systemd-networkd.service \
            timers.target.wants/r36-wifi-setup.timer \
            timers.target.wants/r36-bootlog.timer; do
  where=""
  for base in etc usr/lib; do
    SUDO ls "${MNT}/root/${base}/systemd/system/${want}" >/dev/null 2>&1 && where="${base}"
  done
  [ -n "${where}" ] || { v "  !! not enabled: ${want}"; fail=1; units_ok=0; }
done
# r36-usb-gadget must NOT be enabled: the OTG controller is the WiFi module's
# (it enumerates as usb 1-1 on dwc2), so in the host mode WiFi requires there is no
# UDC, and the unit only burns its 90 s start timeout before failing.  Asserted
# negatively because ${BUILD}/image/system is merged into, never wiped - a link that
# an older build's enable_service created survives even after the recipe stops
# calling it, which is exactly how this unit came back after being un-enabled.
for base in etc usr/lib; do
  if SUDO test -e "${MNT}/root/${base}/systemd/system/multi-user.target.wants/r36-usb-gadget.service"; then
    die "r36-usb-gadget.service is enabled in ${base} - it cannot work on this board (no UDC while WiFi owns the OTG port); delete the stale wants link from ${BUILD}/image/system"
  fi
done

# a link whose target does not exist *inside the image*.  `find -xtype l` cannot
# express that: it resolves an absolute symlink against the build host's /, so every
# /lib/systemd/system/... link in a mounted rootfs looked broken and the check cried
# wolf at thirteen healthy links.  Test each target the way the device's systemd will:
# absolute targets against the mounted root, relative ones against their own directory.
dangling=""
for l in $(SUDO find "${MNT}/root/etc/systemd/system" "${MNT}/root/usr/lib/systemd/system" \
                   -maxdepth 2 -type l 2>/dev/null); do
  t=$(SUDO readlink "${l}")
  # a link to /dev/null IS the mask - systemd's own idiom, not a broken link
  [ "${t}" = "/dev/null" ] && continue
  case "${t}" in
    /*) SUDO test -e "${MNT}/root${t}" || dangling+=" ${l#${MNT}/root/}->${t}" ;;
    *)  SUDO test -e "$(dirname "${l}")/${t}" || dangling+=" ${l#${MNT}/root/}->${t}" ;;
  esac
done
[ -z "${dangling}" ] || { v "  !! links that break inside the image:${dangling}"; fail=1; units_ok=0; }
# only claim success when this block actually succeeded - it used to print
# "10 enabled units found, no dangling wants links" on the same run that listed
# seven "!! not enabled" lines and fourteen dangling links
[ "${units_ok}" = 1 ] && v "  10 enabled units found (in /etc or /usr/lib), no dangling wants links"

# 2. every filename a boot*.ini loads must be on the FAT partition.  u-boot 2017.09
#    resolves filenames literally; one typo is a black screen and this board has no
#    serial port to print the error to.
for ini in "${MNT}/boot/boot.ini" "${MNT}/boot/boot-usbhost.ini"; do
  [ -e "${ini}" ] || { v "  !! missing ${ini}"; fail=1; continue; }
  for n in $(SUDO sed -n 's/^load mmc 1:1 ${[^ ]*} \([^ ]*\)$/\1/p' "${ini}" | tr -d '\r' | sort -u); do
    SUDO ls "${MNT}/boot/${n}" >/dev/null 2>&1 \
      || { v "  !! $(basename "${ini}") loads '${n}', which is not on the FAT"; fail=1; }
  done
  v "  $(basename "${ini}"): every file it loads is present"
done

# 3. EmulationStation was in no image at all before v21 - the scripts existed, the
#    packaged rootfs did not.  Assert the launcher, the binary and both cfgs ES needs,
#    and that the cfgs still carry this board's GUID and stick axes.
for f in usr/local/bin/emulationstation usr/local/bin/r36-es \
         etc/emulationstation/es_input.cfg etc/emulationstation/es_systems.cfg \
         root/.emulationstation/es_input.cfg root/.emulationstation/es_systems.cfg; do
  SUDO ls "${MNT}/root/${f}" >/dev/null 2>&1 || { v "  !! missing: /${f}"; fail=1; }
done
SUDO grep -q 'deviceGUID="19009b4d4b4800000111000000010000"' \
     "${MNT}/root/etc/emulationstation/es_input.cfg" 2>/dev/null \
  || { v "  !! es_input.cfg lost this board's GUID"; fail=1; }
for axis in joystick1left joystick1up; do
  SUDO grep -q "name=\"${axis}\"" "${MNT}/root/etc/emulationstation/es_input.cfg" 2>/dev/null \
    || { v "  !! es_input.cfg lost the ${axis} binding (the stick cannot move the cursor)"; fail=1; }
done
SUDO grep -q '<system>' "${MNT}/root/etc/emulationstation/es_systems.cfg" 2>/dev/null \
  || { v "  !! es_systems.cfg has zero systems - ES would exit or draw nothing"; fail=1; }
# The binary alone is not an installable EmulationStation: without the resources tree
# it starts, runs, and paints nothing readable (measured: 3429 of 3438 log lines were
# missing-font errors, and the same run after copying the tree had zero).  Check for a
# font and a help icon by name, because "the directory exists" would also be true if it
# shipped empty.
for r in ubuntu_condensed.ttf help/button_a.svg; do
  SUDO ls "${MNT}/root/usr/local/bin/resources/${r}" >/dev/null 2>&1 \
    || { v "  !! ES resources missing ${r} - it would start with no fonts or help icons"; fail=1; }
done
v "  ES resources: $(SUDO find "${MNT}/root/usr/local/bin/resources" -type f 2>/dev/null | wc -l) files, $(SUDO du -sh "${MNT}/root/usr/local/bin/resources" 2>/dev/null | cut -f1)"
# Emulation without an emulator is the failure this whole slice was about: ES starts,
# looks fine, and every system is missing because either RetroArch, a core, or the
# /roms directory it scans is not in the image. Empty directories have disappeared on
# the way to the packed root before, so the check is "the dir is there and holds
# something", not "the dir is there".
SUDO ls "${MNT}/root/usr/bin/retroarch" >/dev/null 2>&1 \
  || { v "  !! retroarch is not in the image"; fail=1; }
ncores=$(SUDO ls "${MNT}/root/usr/lib/libretro"/*_libretro.so 2>/dev/null | wc -l)
v "  libretro cores: ${ncores} ($(SUDO ls "${MNT}/root/usr/lib/libretro" 2>/dev/null | tr '\n' ' '))"
[ "${ncores}" -ge 1 ] || { v "  !! no libretro core installed - every system would fail to launch"; fail=1; }

# A count cannot catch the two failures that actually happened on this board: a <core>
# name that does not match the installed library's stem (r36-play turns it into a file
# name, so the game dies at launch with nothing wrong in the image), and a <path> whose
# directory is not in the image (ES drops that system without an error). Check the pair
# instead of the totals: every system in the shipped cfg, every core it names, every
# directory it scans.
ESCFG="${MNT}/root/etc/emulationstation/es_systems.cfg"
esmap=$(SUDO cat "$ESCFG" 2>/dev/null | awk '
  /<system>/{n="";p="";c=""}
  /<name>/{sub(/.*<name>/,"");sub(/<\/name>.*/,"");n=$0}
  /<path>/{sub(/.*<path>/,"");sub(/<\/path>.*/,"");p=$0}
  /<core>/{sub(/.*<core>/,"");sub(/<\/core>.*/,"");c=c" "$0}
  /<\/system>/{if(n!="")print n"\t"p"\t"c}')
nsys=0
while IFS="$(printf '\t')" read -r sysname syspath syscores; do
  [ -n "${sysname}" ] || continue
  nsys=$((nsys+1))
  for c in ${syscores}; do
    SUDO ls "${MNT}/root/usr/lib/libretro/${c}_libretro.so" >/dev/null 2>&1 \
      || { v "  !! system ${sysname} declares core '${c}' but that library is not in the image"; fail=1; }
  done
  sn=$(SUDO find "${MNT}/root${syspath}" -type f 2>/dev/null | wc -l)
  { [ -d "${MNT}/root${syspath}" ] && [ "${sn}" -ge 1 ]; } \
    || { v "  !! system ${sysname} scans ${syspath}, which is absent or empty - ES would drop it silently"; fail=1; }
done <<< "${esmap}"
v "  cfg systems cross-checked: ${nsys} (every <core> installed, every <path> present and non-empty)"
[ "${nsys}" -ge 8 ] || { v "  !! es_systems.cfg declares ${nsys} systems, expected at least 8"; fail=1; }

# The theme is 288 MB of files, so it is exactly the kind of thing that can silently
# not arrive (see the /roms empty-directory case). A theme directory with no files, or a
# ThemeSet that does not name it, both leave ES on the built-in look with no error.
nth=$(SUDO find "${MNT}/root/root/.emulationstation/themes/art-book-next" -type f 2>/dev/null | wc -l)
v "  art-book theme: ${nth} files under /root/.emulationstation/themes/art-book-next"
[ "${nth}" -ge 1000 ] || { v "  !! the art-book theme is missing or nearly empty (${nth} files)"; fail=1; }
SUDO grep -q 'name="ThemeSet" value="art-book-next"' "${MNT}/root/root/.emulationstation/es_settings.cfg" 2>/dev/null \
  || { v "  !! es_settings.cfg does not select art-book-next - ES would show its default theme"; fail=1; }

# Translations need BOTH halves or the LANGUAGE menu row silently does nothing:
# the catalog under /usr/share/locale (ES binds gettext there, main.cpp:348) and a
# non-C "carrier" locale, because glibc ignores LANGUAGE while the effective locale is
# in the C family (measured on the board 2026-10-09).  One carrier serves every
# language - LANGUAGE picks the catalog, and fr_FR resolves to the fr directory.
# Neither half missing produces an error.
ncat=$(SUDO find "${MNT}/root/usr/share/locale" -name emulationstation2.mo 2>/dev/null | wc -l)
v "  ES catalogs: ${ncat} emulationstation2.mo under /usr/share/locale"
[ "${ncat}" -ge 30 ] || { v "  !! expected the ~35 upstream catalogs, got ${ncat} - the host is missing msgfmt?"; fail=1; }
SUDO test -f "${MNT}/root/usr/lib/locale/zh_CN.UTF-8/LC_MESSAGES/SYS_LC_MESSAGES" \
  || { v "  !! no non-C carrier locale in /usr/lib/locale - LANGUAGE would be ignored and ES stays English whatever the menu says"; fail=1; }
SUDO grep -q 'name="Language" value="zh_CN"' "${MNT}/root/root/.emulationstation/es_settings.cfg" 2>/dev/null \
  || { v "  !! es_settings.cfg has no Language default - r36-es would start ES in English"; fail=1; }
nrom=$(SUDO ls -1d "${MNT}/root/roms"/*/ 2>/dev/null | wc -l)
v "  /roms system dirs: ${nrom}"
[ "${nrom}" -ge 20 ] || { v "  !! /roms is missing or nearly empty - ES drops systems whose path does not exist"; fail=1; }
SUDO grep -q '<name>nes</name>' "${MNT}/root/etc/emulationstation/es_systems.cfg" 2>/dev/null \
  || { v "  !! es_systems.cfg still has no real system"; fail=1; }
SUDO ls "${MNT}/root/usr/local/bin/r36-play" >/dev/null 2>&1 \
  || { v "  !! r36-play missing - ES cannot pass -emulator/-core to retroarch"; fail=1; }
v "  ES present: binary, launcher, and both cfgs with the verified GUID + stick axes"

# A package can be rebuilt and still ship the OLD copy: `make image` only re-runs
# INSTALL for packages it thinks changed, and ${BUILD}/image/system is merged into,
# never wiped.  Both halves of the language work are worth catching this way - the
# relaunch loop lives only in the launcher text (so grep sees it), while the ES fixes
# are in a stripped ELF (so compare bytes against what install_pkg produced).
for probe in 'unset LC_MESSAGES LANGUAGE' 'language changed ('; do
  SUDO grep -qF "${probe}" "${MNT}/root/usr/local/bin/r36-es" 2>/dev/null \
    || { v "  !! /usr/local/bin/r36-es in the image has no '${probe}' - a stale es-launcher copy"; fail=1; }
done
img_es=$(SUDO sha256sum "${MNT}/root/usr/local/bin/emulationstation" 2>/dev/null | cut -d' ' -f1)
pkg_es=$(sha256sum ${BUILD}/install_pkg/emulationstation-*/usr/local/bin/emulationstation 2>/dev/null | head -1 | cut -d' ' -f1)
v "  ES binary: image=${img_es:0:16} install_pkg=${pkg_es:0:16}"
[ -n "${img_es}" ] && [ "${img_es}" = "${pkg_es}" ] \
  || { v "  !! the image did not pick up the emulationstation package's current install"; fail=1; }

# PortMaster ships as a pinned archive that is unpacked on first use, so the pack
# cannot check the runtime - it can only check that the thing r36-portmaster needs is
# there.  A missing zip is otherwise invisible until someone selects "Start PortMaster"
# on the device and it says no.
SUDO test -f "${MNT}/root/usr/config/PortMaster/release/PortMaster.zip" \
  || { v "  !! PortMaster release zip missing - r36-portmaster cannot seed /roms/ports"; fail=1; }
for f in r36-portmaster r36-port; do
  SUDO test -x "${MNT}/root/usr/local/bin/$f" \
    || { v "  !! /usr/local/bin/$f missing or not executable"; fail=1; }
done
SUDO test -f "${MNT}/root/roms/ports/Start PortMaster.sh" \
  || { v "  !! /roms/ports/Start PortMaster.sh missing - ES would show an empty Ports system"; fail=1; }
# Without these two PortMaster cannot start any port here (empty DEVICE -> whole
# controller DB into one env var -> E2BIG on every execve), so they are worth a check.
for f in gamecontrollerdb-r36max2.txt fix_control.py; do
  SUDO test -f "${MNT}/root/usr/config/PortMaster/$f" \
    || { v "  !! /usr/config/PortMaster/$f missing - ports would fail with 'Argument list too long'"; fail=1; }
done
v "  PortMaster: pinned release zip, both launchers, the ES entry, and the two board fixes"
# PortMaster's GUI (pugwash) dlopens the SDL2 extension libraries through PySDL2, and a
# missing one does not raise: PySDL2 simply does not create the submodule, so the GUI dies
# later with `AttributeError: module 'sdl2' has no attribute 'sdlimage'` (measured on the
# card 2026-10-10).  They come from rootfs-apt, not from this package, which is why the
# check lives here.
for so in libSDL2_ttf-2.0.so.0 libSDL2_image-2.0.so.0 libSDL2_gfx-1.0.so.0; do
  SUDO test -e "${MNT}/root/usr/lib/aarch64-linux-gnu/$so" \
    || { v "  !! $so missing - PortMaster's GUI would die with 'no attribute sdlimage'"; fail=1; }
done
v "  SDL2 extension libraries for the PortMaster GUI: ttf, image, gfx"

# 4. one kernel tree.  A second /lib/modules directory is how a .ko that nothing loads
#    ends up on a card.
trees=$(SUDO ls "${MNT}/root/lib/modules" 2>/dev/null | tr '\n' ' ')
[ "${trees}" = "${KVER} " ] || { v "  !! /lib/modules holds: ${trees} (want ${KVER} only)"; fail=1; }
v "  /lib/modules: ${trees}"

# 5. every ELF the packages staged under /usr/local/bin must be arm64.  gpu-demos'
#    Makefile hard-coded "gcc" in its recipes, so the framework's CC= only reached the
#    command line and never the compiler actually invoked - a host-compiler leak would
#    otherwise ship x86_64 ELF that dies on the board with an Exec format error that
#    nobody can read, because this board has no console.
staged=0
for f in $(SUDO ls "${MNT}/root/usr/local/bin/" 2>/dev/null); do
  magic=$(SUDO od -An -tx1 -N4 "${MNT}/root/usr/local/bin/${f}" 2>/dev/null | tr -d ' \n')
  # a shell script launcher (r36-es) is expected here, not an ELF
  [ "${magic}" = "7f454c46" ] || continue
  staged=$((staged + 1))
  machine=$(SUDO od -An -tx1 -j18 -N2 "${MNT}/root/usr/local/bin/${f}" 2>/dev/null | tr -d ' \n')
  [ "${machine}" = "b700" ] \
    || { v "  !! ${f} is not aarch64 ELF (e_machine=${machine:-unreadable})"; fail=1; }
done
v "  ${staged} staged ELF binaries, all aarch64"
# zero is a failure, not a pass: /usr/local/bin is where ES, its launcher and the
# gpu demos land, so an empty directory means nothing was merged at all
[ "${staged}" -gt 0 ] || { v "  !! no ELF binaries staged under /usr/local/bin - the package trees were never merged into the rootfs"; fail=1; }

[ "$fail" = 0 ] || { echo "!! verification FAILED - not compressing"; exit 1; }

echo "=== [7] close it out and compress ==="
sync
SUDO umount "${MNT}/root" "${MNT}/boot"
SUDO e2fsck -fy "${LOOP}p2" >/dev/null 2>&1 || true
sync
SUDO losetup -d "${LOOP}"
mkdir -p "${TARGET_IMG}"
time xz -T1 -6 -c "${IMG}" > "${TARGET_IMG}/r36max2-ubuntu-${IMG_V}.img.xz"
( cd "${TARGET_IMG}" && sha256sum "r36max2-ubuntu-${IMG_V}.img.xz" \
    | tee "r36max2-ubuntu-${IMG_V}.img.xz.sha256" )
ls -la "${TARGET_IMG}/r36max2-ubuntu-${IMG_V}.img.xz"

# build manifest: inputs, toolchain, dpkg state, output hash
MANIFEST="${TARGET_IMG}/r36max2-ubuntu-${IMG_V}.manifest.txt"
{
  echo "image: r36max2-ubuntu-${IMG_V}"
  echo "source_date_epoch: ${SOURCE_DATE_EPOCH}"
  echo "kernel: ${KVER}"
  echo "ubuntu-base: $(get_pkg_variable rootfs-base PKG_VERSION) sha256=$(get_pkg_variable rootfs-base PKG_SHA256)"
  echo "apt-snapshot: ${APT_SNAPSHOT}"
  echo "gcc: $(cat "${TOOLCHAIN}/etc/r36max2-toolchain.gcc" 2>/dev/null || echo '?') / binutils $(cat "${TOOLCHAIN}/etc/r36max2-toolchain.binutils" 2>/dev/null || echo '?')"
  echo "busybox: $(get_pkg_variable busybox PKG_VERSION)"
  echo "joypad: $(get_pkg_variable rocknix-joypad PKG_VERSION)"
  echo "aic8800: $(get_pkg_variable aic8800 PKG_VERSION) / fw $(get_pkg_variable aic8800-dc-fw PKG_VERSION)"
  echo "vendor-blobs:"; sed 's/^/  /' "${BLOBS_SUMS}"
  echo "dpkg-count: $(wc -l < "${R}/etc/r36max2/dpkg-manifest.txt" 2>/dev/null || echo 0)"
  cat "${TARGET_IMG}/r36max2-ubuntu-${IMG_V}.img.xz.sha256"
} > "${MANIFEST}"
echo "=== manifest: ${MANIFEST}"
echo "=== IMAGE DONE ==="
