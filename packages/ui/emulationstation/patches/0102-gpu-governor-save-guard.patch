--- a/es-app/src/guis/GuiMenu.cpp	2026-10-09 14:19:54.490020927 +0800
+++ b/es-app/src/guis/GuiMenu.cpp	2026-10-09 14:19:54.550125476 +0800
@@ -2133,6 +2133,20 @@
 	s->addWithLabel(_("DEFAULT GPU SCALING GOVERNOR"), optionsGpuGovernors);
 	s->addSaveFunc([selectedGpuGovernor, optionsGpuGovernors]
 	{
+		// r36max2: getAvailableGpuGovernors() enumerates through
+		// /etc/profile.d/099-freqfunctions, a ROCKNIX-only helper a plain Ubuntu rootfs
+		// does not have, so on this board the list comes back EMPTY.  The CPU governor
+		// list above survives only because GuiMenu.cpp:2101-2102 appends a fallback
+		// entry; here selectFirstItem() cannot select from nothing (it checks
+		// mEntries.size() > 0), so nothing ends up selected - and getSelected() below is
+		// getSelectedObjects().at(0) on an empty vector: std::out_of_range -> TRYCATCH
+		// rethrow -> terminate -> SIGABRT (rc=134).  Measured 2026-10-09 by interposing
+		// __cxa_throw on the device:
+		//   main.cpp:782 -> InputManager.cpp:879 -> Window.cpp:288
+		//   -> GuiSettings.cpp:101 (the save pass) -> this lambda
+		if (optionsGpuGovernors->getSelectedObjects().empty())
+			return;
+
 		if (optionsGpuGovernors->changed()) {
 			SystemConf::getInstance()->set("system.gpuperf", optionsGpuGovernors->getSelected());
 		}
