#!/bin/sh
# r36-ons - start one visual-novel game from the .ons marker inside its folder.
#
# The engine has no "load this script file" argument: -r/--root (onscripter_main.cpp:370)
# takes the DIRECTORY, and ONScripter then looks for nscript.dat / script Lusfas / .arc /
# .nsa inside it. ES gives us the marker file, so the launch is "the folder containing it".
set -u

rom=""
while [ $# -gt 0 ]; do
	case "$1" in
		-emulator|-core) shift 2 ;;   # ES appends these; the engine would treat them as options
		-*) shift ;;
		*)   rom="$1"; shift ;;
	esac
done

if [ -z "$rom" ] || [ ! -e "$rom" ]; then
	echo "r36-ons: no .ons marker given (usage: r36-ons <path/to/game>/<name>.ons)" >&2
	exit 2
fi

# ES gives the marker, so the game is its dirname. Hand-testing this launcher on a board
# over ssh means typing the folder, and passing a folder here used to produce
#   can't open any of 0.txt, 00.txt, nscript.dat and nscript.___
# from onsyuri - an engine-shaped error for a launcher-shaped mistake, which cost a round
# of blaming the game data. Take either form.
if [ -d "$rom" ]; then
	game="$rom"
else
	game="$(dirname "$rom")"
fi
if [ ! -d "$game" ]; then
	echo "r36-ons: $game is not a directory" >&2
	exit 3
fi

# Same two variables r36-port exports, for the same measured reason: this is an SDL2 program
# on a board with no X and no compositor running while a game holds the console.
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-kmsdrm}"
export SDL_AUDIODRIVER="${SDL_AUDIODRIVER:-alsa}"
export HOME="${HOME:-/root}"

# The flags below were wrong in the first version of this file and the binary said so:
#   unknown option -fullscreen / unknown option -enc:gbk   -> exit 255
# Read the built binary's own --help instead of the source again: the option loop compares
# argv+1, so a long option needs BOTH dashes (`--fullscreen`, `--enc:gbk`), while `-r` is
# the accepted short form of `--root`. Only `-r`, `-f` and `-v`/`-h` work with one dash.
#
# cd into the game directory as well: onsyuri opens its font by a bare relative name and
# measured, running from elsewhere gives
#   can't open font file: default.ttf
# even with --root pointing at the folder - the archives are found, the font is not.
# A Windows user double-clicks inside the game folder; matching that is also what the
# reference distro's launcher does.
cd "$game" || { echo "r36-ons: cannot enter $game" >&2; exit 3; }

# -enc:gbk is a default, not a guess about the user's library: the VN releases in this
# region ship GBK-encoded scripts, and with the wrong encoding every line of dialogue is
# mojibake while the engine still "runs". onsyuri --help accepts sjis|gbk|utf8; there is no
# per-game override yet because two games is not enough evidence to design one.
exec /usr/bin/onsyuri --root "$game" --fullscreen --enc:gbk
