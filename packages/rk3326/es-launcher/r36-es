#!/bin/sh
# r36-es - run EmulationStation on this board.
#
# Both display paths work here - measured 2026-10-03, and the earlier "kmsdrm hangs"
# claim was MY artifact, not the board:
#   * kmsdrm (no compositor): plain SDL2 window + GL 3.1 (Mali-G31/Panfrost) + swap
#     succeeded with zero stall messages, as long as nothing else holds DRM master.
#     `sleep 2` after `systemctl stop weston` is NOT enough; SDL then blocks waiting
#     for the master and looks hung.  Wait for the weston process to actually be gone.
#   * weston/Wayland: works too, but weston has twice lost the VOP's vblank permanently
#     after ~23-45 min (stall WARNs, then every frame "Device or resource busy", only a
#     reboot clears it).  Still unexplained.
# The batocera build we finished uses desktop GL (-DUSE_OPENGL_21, GL 3.1 works); the
# ROCKNIX build uses GLES3.  Both run, so the binary is auto-detected instead of pinned.
#
#   r36-es                 # ES inside the weston session (starts weston if needed)
#   r36-es --kmsdrm        # ES on the bare console, master properly released
#   r36-es --test 15       # start, run 15 s, quit, report what happened
#   r36-es --status        # binary, weston, bridge, clients, stall counter
#   r36-es --stop          # kill ES, restore the joypad bridge
#
# THE JOYPAD BRIDGE IS STOPPED WHILE ES RUNS, ON PURPOSE (2026-10-03, measured):
# r36-keymapper grabs /dev/input/event2 with EVIOCGRAB.  While it holds that grab SDL
# still ENUMERATES retrogame_joypad (17 buttons, 4 axes, right GUID) but reads ZERO
# events - so ES shows a pad that is completely dead, and the only thing that reaches ES
# is the bridge's keyboard/mouse echo, where A/B are mouse clicks ES never binds.
# With the bridge stopped, ES gets the real device: dpad, A/B/X/Y, L/R/L2/R2, L3/R3,
# START, SELECT all verified by evtest in the same session.  The bridge is restored
# automatically when ES exits (and by --stop) so the desktop/browser keeps stick-as-mouse.
BRIDGE=r36-keymapper
RT=/run/wayland
SOCK=wayland-0
ES=${ES_BIN:-}

find_es() {
    [ -n "$ES" ] && [ -x "$ES" ] && return 0
    for c in /usr/local/bin/emulationstation /root/es/emulationstation \
             /root/es/build/es-app/emulationstation /usr/bin/emulationstation; do
        [ -x "$c" ] || continue
        # newest wins: two trees on this board, one half-finished, and picking the stale
        # one is the "old binary lied to me" mistake all over again
        [ -z "$ES" ] && ES=$c && continue
        [ "$c" -nt "$ES" ] && ES=$c
    done
    [ -n "$ES" ] && return 0
    echo "  !! no emulationstation binary found - build finished? (TREE=es bash scripts/k72-es-resume.sh status)"
    return 1
}

# ES's UI language comes from the ENVIRONMENT, not from its own setting.  This build
# has -DHAVE_INTL, so _(x) is glibc gettext, and startup only ever calls
# EsLocale::init("", ...) (es-app/src/main.cpp:345-348) - nothing hands the "Language"
# value the menu saves into es_settings.cfg to setenv/setlocale.  So the launcher does.
#
# Two things have to be true, and they are independent (both measured on the board
# 2026-10-09 with a probe linked against the same glibc gettext ES uses):
#
#   1) a NON-C-family locale must be resolvable, because LANGUAGE is ignored while the
#      effective locale is in the C family:
#        LC_ALL=C.UTF-8 LANGUAGE=fr_FR                      -> "SETTINGS"
#        LANG=fr_FR.UTF-8 LANGUAGE=fr_FR (no such locale)   -> "SETTINGS"
#   2) the catalog, not the locale, decides the language.  One generated locale carries
#      every language, because glibc walks LANGUAGE and truncates the region:
#        LC_MESSAGES=zh_CN.UTF-8 LANGUAGE=fr_FR  -> "PARAMÈTRES"   (fr, not zh!)
#        LC_MESSAGES=zh_CN.UTF-8 LANGUAGE=zh_CN  -> "设置"
#      (fr_FR has no directory of its own; gettext falls back to fr.)
#
# So this picks any usable "carrier" locale out of /usr/lib/locale and lets LANGUAGE
# choose the catalog.  Generating one locale per language would have cost ~3.1 MB x 35
# for nothing; see ES_LOCALES_TO_GENERATE in packages/ui/emulationstation/package.mk.
# Only LC_MESSAGES is exported, so LC_CTYPE stays C.UTF-8 and nothing else on the box
# changes its idea of what a character is.
read_language() {
    sed -n 's#.*<string name="Language" value="\([^"]*\)".*#\1#p' \
        "${HOME:-/root}/.emulationstation/es_settings.cfg" 2>/dev/null | head -1
}

apply_language() {
    lang=$(read_language)
    case "$lang" in
        ""|en_US|en)
            echo "  language: en_US (msgid language, no catalog to load)"
            return 0
            ;;
    esac

    # which language will actually be found?  the exact code, else the region-stripped
    # one - matching what glibc gettext itself does, so the warning below is truthful.
    base=${lang%%_*}
    found=""
    for c in "$lang" "$base"; do
        [ -f "/usr/share/locale/${c}/LC_MESSAGES/emulationstation2.mo" ] && { found="$c"; break; }
    done
    if [ -z "$found" ]; then
        echo "  !! no catalog for ${lang} under /usr/share/locale - ES stays English"
        return 0
    fi

    carrier=""
    for d in /usr/lib/locale/*; do
        [ -f "${d}/LC_MESSAGES/SYS_LC_MESSAGES" ] || continue
        name=$(basename "$d")
        # C and POSIX (and C.utf8) are C-family: LANGUAGE stays ignored with them
        case "$name" in
            C|C.*|POSIX) continue ;;
        esac
        carrier="$name"
        break
    done
    if [ -z "$carrier" ]; then
        echo "  !! no non-C locale in /usr/lib/locale, so LANGUAGE would be ignored"
        echo "     and ES would stay English whatever the menu says."
        echo "     Generate one: localedef -i <lang> -f UTF-8 /usr/lib/locale/<lang>.UTF-8"
        return 0
    fi

    LC_MESSAGES="$carrier" LANGUAGE="$lang"
    export LC_MESSAGES LANGUAGE
    echo "  language: ${lang} (catalog ${found}) via carrier LC_MESSAGES=${carrier}"
}

stall() { journalctl -b -k --no-pager 2>/dev/null | grep -cE 'vblank wait timed out|wait_for_vblanks|flip_done timed out'; }

# Count ES by PROCESS NAME, never by `pgrep -f "$ES"`.  Measured 21:02: the argv pattern
# matched (a) the stdbuf/setsid wrapper's child and (b) my own watch_bridge helper, whose
# argv literally contains ESBIN='/root/es/emulationstation' - so "alive=2" was a lie and
# the watcher could never see ES disappear.
#
# And `pgrep -x emulationstation` is NOT usable either: comm is truncated to 15 chars
# ("emulationstatio"), so -x on the 16-character name matches NOTHING - it reported
# "ES procs: 0" while pid 50456 was alive.  pgrep sees the real process as argv[0], so
# anchor on that: helper shells start with "sh", ES starts with its absolute path.
es_count() { pgrep -c emulationstatio 2>/dev/null | head -1; }
es_running() { pgrep -c emulationstatio >/dev/null 2>&1; }


BRIDGE_WAS=inactive
bridge_off() {
    BRIDGE_WAS=$(systemctl is-active $BRIDGE 2>/dev/null)
    if [ "$BRIDGE_WAS" = active ]; then
        systemctl stop $BRIDGE 2>/dev/null
        i=0
        # it has to be REALLY gone or the grab lingers; the unit once took its whole
        # stop timeout (SIGTERM ignored -> SIGKILL), so poll instead of sleeping blindly
        while [ $i -lt 20 ] && pgrep -f "$BRIDGE.py" >/dev/null; do sleep 1; i=$((i + 1)); done
        echo "  joypad bridge stopped (was $BRIDGE_WAS, ${i}s to release) so ES can read the pad"
    else
        echo "  joypad bridge already $BRIDGE_WAS"
    fi
}

bridge_on() {
    [ "$(systemctl is-active $BRIDGE 2>/dev/null)" = active ] && { echo "  bridge already active"; return 0; }
    # Restore only what was actually running. The unit is BindsTo=weston.service, so a
    # blind `systemctl start` here would also start the compositor - which is precisely
    # what --kmsdrm is trying to avoid (weston on 7.2.8 can wedge the VOP permanently).
    [ "$BRIDGE_WAS" = active ] || { echo "  bridge was $BRIDGE_WAS before ES ran, leaving it off"; return 0; }
    systemctl start $BRIDGE 2>/dev/null
    sleep 2
    echo "  joypad bridge back $(systemctl is-active $BRIDGE) (stick=mouse, keys=keyboard for desktop apps)"
}

watch_bridge() {
    # detached guard: ES usually runs in the background here (and over ssh there is no
    # session left to trap on), so restore the bridge when the ES process disappears.
    # -x on purpose: a -f pattern would match this very helper's own argv and it would
    # never notice ES going away.
    setsid sh -c '
        while pgrep -c emulationstatio >/dev/null 2>&1; do sleep 5; done
        [ "'"$BRIDGE_WAS"'" = active ] && systemctl start '"$BRIDGE"' 2>/dev/null
    ' >/dev/null 2>&1 &
}

need_weston() {
    [ -S "$RT/$SOCK" ] && return 0
    echo "  starting weston (ES needs a compositor on this board)"
    systemctl start weston
    i=0
    while [ $i -lt 20 ]; do
        [ -S "$RT/$SOCK" ] && return 0
        sleep 0.5
        i=$((i + 1))
    done
    echo "  !! weston socket never appeared:"
    journalctl -u weston --no-pager -n 15
    return 1
}

run_es() {
    export XDG_RUNTIME_DIR=$RT WAYLAND_DISPLAY=$SOCK
    export SDL_VIDEODRIVER=wayland SDL_AUDIODRIVER=alsa
    export HOME=${HOME:-/root}
    apply_language
    # stdbuf: ES is often killed by a timer during testing, and a killed process
    # loses its buffered stdout - which reads as "the log is empty, it never ran"
    setsid stdbuf -oL -eL "$ES" --no-splash "$@" > /tmp/es-run.log 2>&1 &
}

case "${1:-run}" in
    --status|status)
        find_es || exit 1
        echo "  es binary : $ES ($(stat -c %s "$ES") bytes, built $(stat -c %y "$ES" | cut -c1-19))"
        echo "  weston    : $(systemctl is-active weston)  socket=$([ -S $RT/$SOCK ] && echo yes || echo no)"
        echo "  es procs  : $(pgrep -a emulationstatio 2>/dev/null | head -3 | tr '\n' ' ')"
        echo "  bridge    : $(systemctl is-active $BRIDGE)  (should be inactive while ES runs, active otherwise)"
        echo "  pad readers: $(for p in $(ls /proc | grep -E '^[0-9]+$'); do ls -l /proc/$p/fd 2>/dev/null | grep -q 'input/event2' && printf '%s:%s ' $(cat /proc/$p/comm 2>/dev/null) $p; done)"
        echo "  roms      : $(ls /root/roms 2>/dev/null | head -6 | tr '\n' ' ')"
        echo "  config    : $(ls /root/.emulationstation 2>/dev/null | tr '\n' ' ')"
        echo "  language  : setting=$(sed -n 's#.*<string name="Language" value="\([^"]*\)".*#\1#p' "${HOME:-/root}/.emulationstation/es_settings.cfg" 2>/dev/null | head -1)  catalogs=$(ls /usr/share/locale/*/LC_MESSAGES/emulationstation2.mo 2>/dev/null | wc -l)  locales=$(ls -d /usr/lib/locale/*.UTF-8 2>/dev/null | wc -l)"
        echo "  running ES LC_MESSAGES: $(for p in $(pgrep emulationstatio 2>/dev/null | head -1); do tr '\0' '\n' < /proc/$p/environ 2>/dev/null | grep -E '^(LC_MESSAGES|LANGUAGE)=' | tr '\n' ' '; done)"
        echo "  stall since boot: $(stall)"
        ;;
    --stop)
        # name-substring match, NOT -x (comm is truncated to 15 chars, so `-x
        # emulationstation` matches nothing and --stop would silently do nothing)
        pkill emulationstatio 2>/dev/null
        sleep 2
        echo "  es procs after pkill: $(es_count 2>/dev/null || echo 0)   weston=$(systemctl is-active weston)"
        bridge_on
        ;;
    --kmsdrm)
        shift
        find_es || exit 1
        # the whole point of these lines: wait until the card is really free,
        # otherwise SDL blocks on drmSetMaster and looks like a kernel hang
        if systemctl is-active --quiet weston; then
            echo "  stopping weston and waiting for it to release DRM master..."
            systemctl stop weston 2>/dev/null
        fi
        bridge_off
        i=0
        while [ $i -lt 40 ] && pgrep -x weston >/dev/null; do sleep 3; i=$((i + 3)); done
        echo "  weston=$(systemctl is-active weston) procs=$(pgrep -cx weston) card0 holders=[$(fuser /dev/dri/card0 2>/dev/null | tr '\n' ' ')]"
        if [ "$(pgrep -cx weston)" != 0 ]; then
            echo "  !! something still holds the console; refusing to start (it would just block)"
            bridge_on
            exit 1
        fi
        chvt 1 2>/dev/null
        export SDL_VIDEODRIVER=kmsdrm SDL_AUDIODRIVER=alsa XDG_VTNR=1 HOME=${HOME:-/root}
        unset WAYLAND_DISPLAY XDG_RUNTIME_DIR
        echo "  stall counter before start: $(stall)"
        # not exec: the bridge must come back when ES exits, even from Ctrl-C
        #
        # A language change can only land on a NEW process: this build has
        # -DHAVE_INTL so _(x) is glibc gettext, whose locale is fixed by the
        # setlocale() done at startup (main.cpp:345-348), and ES never hands its own
        # "Language" setting to it - this launcher does, before the process starts.
        # ES's own "RESTART EMULATIONSTATION" row is not a restart: GuiMenu.cpp:6016
        # calls quitES(QuitMode::QUIT), the same thing the plain QUIT row does
        # (Platform.cpp:216-238 only pushes SDL_QUIT and returns 0), and
        # r36-es.service is Restart=on-failure on purpose so a clean exit lands on
        # the console.  Re-run here when the setting actually changed, which is what
        # the user means by "restart ES to apply it"; anything else still exits to
        # the console as before.
        while :; do
            lang_before=$(read_language)
            apply_language
            stdbuf -oL -eL "$ES" --fullscreen --no-splash "$@"
            rc=$?
            lang_after=$(read_language)
            [ "$lang_before" != "$lang_after" ] || break
            echo "  language changed (${lang_before:-en_US} -> ${lang_after}); restarting ES to apply it"
        done
        echo "  ES exited rc=$rc; restoring the joypad bridge"
        bridge_on
        exit $rc
        ;;
    --test)
        T=${2:-15}
        find_es || exit 1
        need_weston || exit 1
        bridge_off
        s0=$(stall)
        run_es
        i=0
        while [ $i -lt "$T" ]; do
            sleep 3; i=$((i + 3))
            echo "  t=${i}s alive=$(es_count 2>/dev/null || echo 0) stall=$(stall)"
        done
        echo "  --- es-run.log ---"
        head -30 /tmp/es-run.log 2>/dev/null | sed 's/^/     /'
        alive=$(es_count 2>/dev/null || echo 0)
        pkill emulationstatio 2>/dev/null
        echo "  survived the window: $([ "$alive" != 0 ] && echo YES || echo 'no - it exited')"
        echo "  stalls before=$s0 after=$(stall)"
        echo "  weston complaints: $(journalctl -u weston --no-pager --since '-60 seconds' 2>/dev/null | grep -cE 'Device or resource busy|repaint-flush failed')"
        bridge_on
        ;;
    ""|run)
        find_es || exit 1
        need_weston || exit 1
        if es_running; then
            echo "  ES is already running ($(es_count) proc(s)); use --stop first"
            exit 0
        fi
        bridge_off
        run_es
        watch_bridge
        sleep 4
        echo "  started: $ES"
        echo "  alive=$(es_count 2>/dev/null || echo 0)  weston=$(systemctl is-active weston)  bridge=$(systemctl is-active $BRIDGE)  stall=$(stall)"
        echo "  log: /tmp/es-run.log     stop: r36-es --stop (that restores the bridge too)"
        echo "  note: 'failed' from systemctl here usually means the bridge was stopped by"
        echo "        SIGKILL after ignoring SIGTERM - the pad is released either way"
        ;;
    *)
        sed -n '1,40p' "$0"
        ;;
esac
