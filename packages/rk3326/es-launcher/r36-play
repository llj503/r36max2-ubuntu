#!/bin/sh
# r36-play - the single launch wrapper ES uses for libretro systems.
#
# Why a wrapper at all: RetroArch would abort on "-emulator", and the core has to turn into
# a filename (/usr/lib/libretro/<core>_libretro.so), so the two pieces of information ES
# knows per launch have to be consumed here.
#
# ES does NOT hand them over unless asked. The append at es-app/src/FileData.cpp:553-557
# (" -emulator %EMULATOR%", " -core %CORE%") is inside `if (forceCore)` at :552, and
# forceCore is only set by the netplay branch at :507-528 - measured on the card, a normal
# launch of /roms/neogeo/kof98.zip arrived as "r36-play /roms/neogeo/kof98.zip" with nothing
# else. So es_systems.cfg now writes "-core %CORE%" itself; %CORE% comes from
# FileData::getCore() (:1437) reading the SystemConf key "<system>.core", which is empty
# until the user picks a core in ES.
#
# Which means this script has to survive "-core" arriving with no value after it - the
# unconfigured default - and still know what to launch: hence the per-system table below,
# which is also what makes the wrapper testable by hand over ssh.
set -u

emu=""
core=""
rom=""
while [ $# -gt 0 ]; do
	case "$1" in
		# A dangling flag must not kill the launch: `shift 2` with one parameter left is an
		# error in dash ("shift: can't shift that many") and aborts the script, which would
		# turn ES's empty %CORE% into a failed game rather than a defaulted one.
		-emulator) [ $# -ge 2 ] || break; emu="$2"; shift 2 ;;
		-core)     [ $# -ge 2 ] || break; core="$2"; shift 2 ;;
		*)         rom="$1"; shift ;;
	esac
done

if [ -z "$rom" ]; then
	echo "r36-play: no ROM given (usage: r36-play <rom> [-emulator E] [-core C])" >&2
	exit 2
fi
if [ -n "$emu" ] && [ "$emu" != retroarch ]; then
	echo "r36-play: emulator '$emu' is not wired up here; only retroarch cores are built" >&2
	exit 3
fi
if [ -z "$core" ]; then
	# ES always tells us which core it picked. Outside ES there is no such answer, and
	# without a fallback this script was untestable by hand - the first verification run
	# of the six-core image failed all six systems with rc=4 for exactly that reason,
	# which said nothing about the cores. Use the system the ROM sits under, which is
	# also the directory name es_systems.cfg declares.
	sys=$(basename "$(dirname "$rom")")
	case "$sys" in
		nes) core=fceumm ;;
		snes) core=snes9x2010 ;;
		gb|gbc) core=gambatte ;;
		gba) core=mgba ;;
		psx) core=pcsx_rearmed ;;
		n64) core=parallel_n64 ;;
		dreamcast) core=flycast ;;
		saturn) core=mednafen_saturn ;;
		# All five arcade folders are the same core; the split is the ROM pack's, not
		# the emulator's (see the comment in es_systems.cfg).
		fbneo|neogeo|arcade|cps1|cps2) core=fbneoplus ;;
		*)
			echo "r36-play: no -core given and no default for system '$sys'" >&2
			exit 4 ;;
	esac
	echo "r36-play: defaulting to core=$core for system=$sys" >&2
fi

SO="/usr/lib/libretro/${core}_libretro.so"
if [ ! -f "$SO" ]; then
	echo "r36-play: core not installed: $SO" >&2
	echo "  present: $(ls /usr/lib/libretro 2>/dev/null | tr '\n' ' ')" >&2
	exit 5
fi

RA_CFG="$HOME/.config/retroarch/retroarch.cfg"
[ -f "$RA_CFG" ] || RA_CFG=""

# The shipped board config wins over the per-user one. Without it RetroArch defaults to
# PulseAudio, which this image does not have, and the game runs silent (measured: same
# core, same ROM, no sound until audio_driver="alsa" is forced).
RA_BOARD=/etc/r36/retroarch.cfg

exec retroarch ${RA_CFG:+-c "$RA_CFG"} \
	${RA_BOARD:+--appendconfig="$RA_BOARD"} \
	--fullscreen -L "$SO" "$rom"
