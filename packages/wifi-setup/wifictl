#!/bin/sh
# wifictl - the WiFi backend EmulationStation's network menu talks to.
#
# ES knows nothing about this board's WiFi. It shells out to exactly one program and
# nothing else: every row, marker and failure box in the menu traces back to a
# `wifictl <subcommand>` here (es-app/src/ApiSystem.cpp: getWifiNetworks ->
# "wifictl scanlist" / "wifictl list", getSavedWifiNetworks -> "wifictl list_saved",
# connectSavedWifiNetwork -> "wifictl connect_saved <ssid>", forgetWifiNetwork ->
# "wifictl forget_saved <ssid>", enableWifi -> "wifictl enable" then
# "wifictl connect <ssid> <psk> <country>", disableWifi -> "wifictl disable",
# isWifiAPModeSupported -> "wifictl has_ap_mode"). That is also why this file has to live
# at /usr/bin/wifictl: isScriptingSupported() tests that literal path, and until it hits,
# the menu entry is not added at all.
#
# Two conventions are obeyed because they were read out of ES, not assumed:
#   * executeScript() is `system(cmd) == 0`, so a failure has to EXIT non-zero. Printing a
#     friendly message and exiting 0 tells the user the network connected.
#   * executeEnumerationScript() turns each stdout line into one menu row through
#     `strtok(line, "\n")`, so a blank line becomes a selectable blank network. The
#     enumeration commands below never print an empty line.
#
# The store is the same file BOOT:\wifi.txt feeds
# (/etc/wpa_supplicant/wpa_supplicant-wlan0.conf), because r36-wpa@wlan0.service reads only
# that path - a network added from the menu is therefore an ordinary saved network, and it
# survives a reboot. The reverse is worth knowing: wifi.txt is *declarative*, editing it
# rewrites the whole file, so it replaces everything the menu had added.
#
# Scanning goes through the supplicant, never through `iw`: measured on this board that
# `iw dev wlan0 scan` fails with "Device or resource busy (-16)" while wpa_supplicant holds
# the interface, which is also why wifi-status.txt's neighbour list came out empty.
set -u

IFACE=wlan0
CONF=/etc/wpa_supplicant/wpa_supplicant-$IFACE.conf
SVC=r36-wpa@$IFACE.service
W=/usr/sbin/wpa_cli
WPA=/usr/sbin/wpa_supplicant
IW=/usr/sbin/iw
CTL="$W -i $IFACE"
COUNTRY_DEFAULT=CN

err() { echo "wifictl: $*" >&2; }

# One line per decision, appended to a file AND to stderr.  stderr is what already reaches
# journalctl through r36-es; the file exists so the sequence can be read off the card in a
# USB reader without a keyboard, serial cable or screen.  It is deliberately NOT under /run:
# the whole point is reading what happened after a reboot moved the card back to the PC, and
# /run is tmpfs.  Nothing that goes through here may contain a passphrase - callers pass the
# SSID and the daemon's answers, and that is on purpose.
AUDIT_DIR=/var/lib/r36-wifictl
AUDIT=$AUDIT_DIR/audit.log
audit() {
    mkdir -p "$AUDIT_DIR" 2>/dev/null
    printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >>"$AUDIT" 2>/dev/null
    err "$*"
}

# Which runtime network the daemon is working on right now, or nothing when it is not
# connected.  The rollback needs the id, not the ssid: after select_network the others are
# disabled, so "go back" has to name the one to re-enable.
#
# The field is spelled `id=` by older wpa_supplicant and `network_id=` by newer ones, and
# this card's version was not measured when the first version of this function was written -
# a lookup that silently returns nothing would have sent every rollback down the fallback
# branch, which is the same class of bug the audit line below exists to catch.  Accept both,
# and never match `id_str=` (the regex is anchored on the `=`).
current_network_id() { $CTL status 2>/dev/null | awk -F= '/^(network_)?id=/{print $2; exit}'; }

# Is $1 present in the daemon's scan table?  "no" here means the daemon has no BSS to
# associate with, which is a completely different answer from "we tried and the AP refused"
# - and neither of them is a passphrase problem, because the key is only examined after the
# association succeeds.  This is the distinction the 2026-10-12 logs could not make.
bss_seen() {
    $CTL scan_results 2>/dev/null | awk -F'\t' -v want="$1" '
        NR > 1 && NF >= 5 {
            s = $5
            for (i = 6; i <= NF; i++) s = s " " $i      # SSIDs contain spaces
            if (s == want) { found = 1; exit }
        }
        END { print (found ? "yes" : "no") }'
}

# --- supplicant lifecycle --------------------------------------------------------

supplicant_up() { [ -S "/run/wpa_supplicant/$IFACE" ]; }

start_supplicant() {
    supplicant_up && return 0
    systemctl start "$SVC" 2>/dev/null
    i=0
    while [ $i -lt 20 ]; do
        supplicant_up && return 0
        sleep 1
        i=$((i + 1))
    done
    err "$IFACE control interface never appeared"
    return 1
}

wpa_state() { $CTL status 2>/dev/null | awk -F= '/^wpa_state=/{print $2}'; }

wpa_ssid() { $CTL status 2>/dev/null | awk -F= '/^ssid=/{print $2}'; }

# Wait for THIS ssid, not merely for "some" association: right after a restart the old
# network is still in the file and still in range, so wpa_state alone goes COMPLETED on the
# network the user did not ask for, and ES would report the failed connection as a success.
wait_for_network() {  # $1 = ssid, $2 = seconds
    i=0
    while [ $i -lt "${2:-40}" ]; do
        if [ "$(wpa_state)" = COMPLETED ] && [ "$(wpa_ssid)" = "$1" ]; then
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    err "still on \"$(wpa_ssid)\" ($(wpa_state)) after ${2:-40}s, not on \"$1\""
    return 1
}

has_ipv4() { ip -4 -br addr show "$IFACE" 2>/dev/null | awk '{print $3}' | grep -q '[0-9]\+\.'; }

ensure_lease() {
    has_ipv4 && return 0
    networkctl reconfigure "$IFACE" 2>/dev/null
    i=0
    while [ $i -lt 15 ]; do
        has_ipv4 && return 0
        sleep 1
        i=$((i + 1))
    done
    err "associated, but no IPv4 lease came up"
    return 1
}

# Association is the success criterion, not the lease. A wrong passphrase never associates,
# which is the failure the user is asking about; an association with no lease is an
# environment problem (static-only network, slow DHCP) and ES's only two answers are
# "connected successfully" and "failed to connect" - the second would be a lie. The wifi.txt
# channel reports the same split as "PARTIAL:" in wifi-status.txt.
connected_ok() {  # $1 = ssid
    wait_for_network "$1" 40 || return 1
    ensure_lease || true
    return 0
}

# --- config file surgery (mawk only - this card has no gawk) ----------------------

# Rewrite $CONF: fresh globals, the block for $2 (unless $3 says open/no-passphrase), and
# every block already in the file EXCEPT one whose ssid equals $2. Line-oriented on
# purpose - a block is only a few lines and matching across newlines in mawk is a trap.
put_network() {  # $1 = ssid, $2 = block text, $3 = country
    {
        printf 'ctrl_interface=DIR=/run/wpa_supplicant GROUP=netdev\n'
        printf 'update_config=1\n'
        printf 'country=%s\n' "$3"
        keep_other_blocks "$1"
        printf '%s\n' "$2"
    } > "$CONF.tmp"
    publish_tmp || return 1
}

remove_network() {  # $1 = ssid, $2 = country
    {
        printf 'ctrl_interface=DIR=/run/wpa_supplicant GROUP=netdev\n'
        printf 'update_config=1\n'
        printf 'country=%s\n' "$2"
        keep_other_blocks "$1"
    } > "$CONF.tmp"
    publish_tmp || return 1
}

# Copy every network block except $1's out of $CONF.
keep_other_blocks() {
    awk -v drop="$1" '
        /^network=[{]/ { inb = 1; hold = $0 "\n"; ismatch = 0; next }
        inb == 1 {
            hold = hold $0 "\n"
            if (ismatch == 0 && $0 ~ /ssid=/) {
                s = $0
                sub(/^[ \t]*ssid=[ \t]*/, "", s)
                sub(/[ \t]*$/, "", s)
                sub(/^"/, "", s)
                sub(/"$/, "", s)
                gsub(/\\"/, "\"", s)
                gsub(/\\\\/, "\\", s)
                if (s == drop) ismatch = 1
            }
            if ($0 ~ /^\}/) {
                if (!ismatch) printf "%s", hold
                inb = 0; hold = ""; ismatch = 0
            }
            next
        }
        inb == 0 && !/^ctrl_interface=/ && !/^update_config=/ && !/^country=/ { print }
    ' "$CONF" 2>/dev/null
}

publish_tmp() {
    if [ ! -s "$CONF.tmp" ]; then
        err "could not build the configuration"
        rm -f "$CONF.tmp"
        return 1
    fi
    # Gate, not decoration: a network block that does not parse makes wpa_supplicant reject
    # the WHOLE file and exit (measured: "Line 8: invalid key_mgmt 'WPA2-PSK'" -> "Failed to
    # read or parse configuration" -> status=255), so one bad block takes every other
    # network down with it. That is exactly how this card lost its working connection for
    # two minutes the first time this script was tried on it.
    if ! validate_conf "$CONF.tmp"; then
        err "refusing to install a configuration wpa_supplicant cannot parse; the current one is unchanged"
        rm -f "$CONF.tmp"
        return 1
    fi
    chmod 600 "$CONF.tmp"
    mv -f "$CONF.tmp" "$CONF" || { err "could not install $CONF"; rm -f "$CONF.tmp"; return 1; }
}

# Run a throwaway wpa_supplicant over the candidate file with a non-existent interface and
# read what it complains about. `-O` is what makes this safe: without it the probe instance
# would take the control interface directory from the file itself. Verified afterwards that
# /run/wpa_supplicant still held only wlan0 + p2p-dev-wlan0 and the live link was undisturbed.
validate_conf() {  # $1 = candidate file
    mkdir -p /run/wifictl-probe 2>/dev/null
    out=$(timeout 8 "$WPA" -c"$1" -D nl80211 -i wifictl-probe0 -O /run/wifictl-probe -dd 2>&1)
    rm -rf /run/wifictl-probe
    if printf '%s\n' "$out" | grep -qE 'invalid|failed to parse|Failed to read or parse'; then
        printf '%s\n' "$out" | grep -E 'invalid|failed to parse' | head -3 | sed 's/^/wifictl: /' >&2
        return 1
    fi
    return 0
}

current_country() { awk -F= '/^country=/{print $2; exit}' "$CONF" 2>/dev/null; }

# wpa_supplicant's own escaping inside a quoted string value.
wpa_quote() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# The verb for setting a network variable, kept in exactly one place.
#
# It is `set_network <id> <variable> <value>` - this card's wpa_cli says so in its own help
# text, which carries the example `set_network 1 ssid "network name"`. There is NO `set`
# command, and `set network …` is worse than a missing verb: wpa_cli matches commands by
# prefix, so it resolved to set_network with the literal word "network" in the position that
# must hold the numeric id. The daemon then read that id as atoi("network") = 0 and was
# handed a nonsense variable name, which is why all six replies on 2026-10-12 09:02:08 were
# `FAIL` - and why the network it aimed at was id 0, the one the card was actually using.
# Refusing was the daemon's right answer; my call was the bug.
set_net() { $CTL set_network "$@" 2>&1; }

# PSK *and* SAE are offered, which is what lets a WPA3-Personal network connect from here.
# The token list is measured, not guessed: `WPA2-PSK` is a hostapd word and wpa_supplicant
# rejects it ("Line 8: invalid key_mgmt 'WPA2-PSK'" -> the whole file is refused), while
# `WPA-PSK` already covers both WPA and WPA2 personal - a probe run reported key_mgmt=0x402,
# i.e. WPA-PSK|SAE, for this combination.
# That is also why the passphrase is stored quoted rather than as the PBKDF2 hex the
# wifi.txt channel writes: SAE is a handshake over the password itself, so a pre-hashed PSK
# cannot be used for it. Mode 600, root only, and it is never copied onto the FAT partition.
build_block() {  # $1 = ssid, $2 = psk ("" for an open network)
    s=$(wpa_quote "$1")
    if [ -n "$2" ]; then
        p=$(wpa_quote "$2")
        printf 'network={\n\tssid="%s"\n\tpsk="%s"\n\tkey_mgmt=WPA-PSK SAE\n\tproto=WPA RSN\n\tieee80211w=1\n}' "$s" "$p"
    else
        printf 'network={\n\tssid="%s"\n\tkey_mgmt=NONE\n}' "$s"
    fi
}

network_id_for() {  # $1 = ssid -> its runtime network id, or nothing
    $CTL list_network 2>/dev/null | awk -F'\t' -v want="$1" '
        NR > 1 && $2 != "" && $2 == want { print $1; exit }'
}

# --- enumeration -----------------------------------------------------------------

scan_rows() {
    $CTL scan_results 2>/dev/null | awk -F'\t' '
        NR == 1 { next }                    # "bssid / frequency / signal level / flags / ssid"
        NF < 5  { next }
        {
            ssid = $5
            for (i = 6; i <= NF; i++) ssid = ssid " " $i     # SSIDs contain spaces
            if (ssid ~ /^[ \t]*$/) next                       # hidden network
            if (!(ssid in seen)) { seen[ssid] = 1; print ssid }
        }'
}

rows_now() { $CTL scan_results 2>/dev/null | tail -n +2 | grep -c .; }

cmd_list() {
    supplicant_up || start_supplicant || return 0
    scan_rows
}

cmd_scanlist() {
    start_supplicant || return 1
    # `wpa_cli scan` returns in about 40 ms and the results land up to a second later, so
    # wait for the table to stop growing instead of trusting the return code.
    $CTL scan >/dev/null 2>&1
    prev=-1
    i=0
    while [ $i -lt 8 ]; do
        sleep 1
        now=$(rows_now)
        [ "$now" = "$prev" ] && [ "$now" -gt 0 ] && break
        prev=$now
        i=$((i + 1))
    done
    [ "$(rows_now)" -gt 0 ] || err "the scan returned nothing"
    scan_rows
}

cmd_list_saved() {
    [ -r "$CONF" ] || return 0
    awk '
        /^network=[{]/ { inb = 1; next }
        inb == 1 && $0 ~ /ssid=/ {
            v = $0
            sub(/^[ \t]*ssid=[ \t]*/, "", v)
            sub(/[ \t]*$/, "", v)
            sub(/^"/, "", v)
            sub(/"$/, "", v)
            gsub(/\\"/, "\"", v)
            gsub(/\\\\/, "\\", v)
            if (v != "") print v
        }
        /^\}/ { inb = 0 }
    ' "$CONF"
}

# --- the actions ES reports on ---------------------------------------------------

cmd_connect() {  # $1 = ssid, $2 = psk, $3 = country
    ssid=${1:-}
    psk=${2:-}
    country=${3:-}
    [ -n "$country" ] || country=$COUNTRY_DEFAULT
    [ -n "$ssid" ] || { err "connect: empty SSID"; return 1; }
    if [ ${#psk} -gt 0 ] && [ ${#psk} -lt 8 ]; then
        err "connect: a WPA passphrase needs at least 8 characters"
        return 1
    fi
    case "$country" in
        [A-Z][A-Z]) : ;;
        *) country=$COUNTRY_DEFAULT ;;
    esac

    # Snapshot the file AND the daemon's notion of "what are we connected to", because the
    # rollback needs both.  This is not theoretical: with an in-range SSID and a wrong
    # passphrase, wpa_supplicant keeps working on that one network and never returns to the
    # one that was working, so a failed attempt from the menu took this card off the LAN
    # completely - and since WiFi is the board's only remote channel, the user was left
    # holding a dead-end screen with no way to inspect it.
    SNAP=/run/wifictl-connect-snapshot.conf
    cp -a "$CONF" "$SNAP" 2>/dev/null || SNAP=""
    was_id=$(current_network_id)

    start_supplicant || { [ -z "$SNAP" ] || restore_snapshot "$ssid"; return 1; }

    # `iw reg set` restarts the channel, and on this chip that is not free. Only touch it
    # when the country is actually changing.
    [ "$(iw_reg_country)" = "$country" ] || $IW reg set "$country" 2>/dev/null

    # Build the network INSIDE the running daemon, with the commands whose names were
    # verified against the binary on this card (`strings /usr/sbin/wpa_cli` has
    # add_network / set / select_network / enable_network / remove_network / reconfigure,
    # and does NOT have `reload`).
    #
    # This replaces a file rewrite plus `reload_config`, and that older design is the bug
    # the 2026-10-12 audit caught red-handed:
    #     reload=[Unknown command 'reload_config'] runtime_id=none bss=yes
    # `reload_config` is not a wpa_cli command at all, so every one of those calls had been
    # failing since the script existed - invisibly, because the reply went to /dev/null.
    # The file was written correctly, the access point was in the scan table, and the daemon
    # had never been told about the new network, so `network_id_for` found nothing, there was
    # nothing to select, and the user was told "failed to connect" about a network that had
    # never once been attempted and a passphrase that had never been tested.
    # Writing the file stays, but only to persist a connection that already worked.
    id=$($CTL add_network 2>&1)
    case "$id" in
        ''|FAIL*) audit "connect: add_network said [$id]";
            [ -z "$SNAP" ] || restore_snapshot "$ssid"; return 1 ;;
    esac

    # Every reply is captured and audited.  That is the whole lesson of the reload_config
    # bug: the commands were being issued and discarded, so a daemon answering "Unknown
    # command" or "FAIL" was indistinguishable from one doing exactly as told.
    ssid_reply=$(set_net "$id" ssid "\"$(wpa_quote "$ssid")\"")
    if [ -n "$psk" ]; then
        # The plaintext, both AKMs, MFP optional - the same parameters build_block writes,
        # and a hashed psk cannot do SAE, which is why the menu stores plaintext at all.
        keymgmt_reply=$(set_net "$id" key_mgmt 'WPA-PSK SAE')
        psk_reply=$(set_net "$id" psk "\"$(wpa_quote "$psk")\"")
        proto_reply=$(set_net "$id" proto 'WPA RSN')
        mfp_reply=$(set_net "$id" ieee80211w 1)
    else
        keymgmt_reply=$(set_net "$id" key_mgmt NONE)
        psk_reply="(open)"
        proto_reply=$(set_net "$id" proto 'WPA RSN')
        mfp_reply=$(set_net "$id" ieee80211w 0)
    fi
    # Ask for it by directed probe too, so a hidden or briefly-absent SSID can still be
    # found instead of timing out silently.
    scanssid_reply=$(set_net "$id" scan_ssid 1)
    audit "connect ssid=\"$ssid\" new_id=$id was_id=${was_id:-none} ssid_reply=[$ssid_reply] keymgmt_reply=[$keymgmt_reply] psk_reply=[$psk_reply] proto_reply=[$proto_reply] mfp_reply=[$mfp_reply] scanssid_reply=[$scanssid_reply] bss=$(bss_seen "$ssid") scan_rows=$(scan_rows | wc -l) state=$(wpa_state) country=$country"

    # A rejected parameter is a hard failure, not something to wait 40 seconds for.
    for r in "ssid=$ssid_reply" "key_mgmt=$keymgmt_reply" "psk=$psk_reply" "proto=$proto_reply" "ieee80211w=$mfp_reply"; do
        case "$r" in
            *=OK) continue ;;
            *) err "connect: the daemon refused set $r"; $CTL remove_network "$id" >/dev/null 2>&1
               [ -z "$SNAP" ] || restore_snapshot "$ssid"; return 1 ;;
        esac
    done

    $CTL enable_network "$id" >/dev/null 2>&1
    $CTL select_network "$id" >/dev/null 2>&1

    # If the SSID is not in the daemon's scan table, naming the network is not enough: wpa
    # associates with a BSS, not with an ssid string, so a select with no matching BSS just
    # waits for someone else to find it.  Ask for a scan and record whether the BSS turned
    # up, because "absent" is a different answer from "the AP refused us" - and neither is
    # a passphrase problem.
    if [ "$(bss_seen "$ssid")" = no ]; then
        audit "connect: \"$ssid\" absent from the scan table - requesting a scan"
        $CTL scan >/dev/null 2>&1
        i=0
        while [ $i -lt 10 ]; do
            [ "$(bss_seen "$ssid")" = yes ] && break
            sleep 1
            i=$((i + 1))
        done
        audit "connect: scanned bss=$(bss_seen "$ssid") scan_rows=$(scan_rows | wc -l) state=$(wpa_state) waited=${i}s"
        $CTL select_network "$id" >/dev/null 2>&1
    fi

    if connected_ok "$ssid"; then
        # It worked, so make it survive a reboot.  If the file write is refused (the parse
        # gate in publish_tmp is there because one unparsable block kills every OTHER
        # network on this card), say so rather than letting "connected" imply "saved".
        put_network "$ssid" "$(build_block "$ssid" "$psk")" "$country" ||
            audit "connected to \"$ssid\", but it could NOT be written to $CONF - it will not survive a reboot"
        return 0
    fi
    [ -z "$SNAP" ] || restore_snapshot "$ssid"
    return 1
}


# What country the wireless core reports right now, or nothing if that cannot be read.
iw_reg_country() {
    $IW reg get 2>/dev/null | awk -F': ' '/^country /{print substr($2, 1, 2); exit}'
}

# The only recovery this chip has without opening the case.  Both AIC modules are loadable
# (/lib/modules/7.2.9/extra/aic_load_fw.ko + aic8800_fdrv.ko, listed in
# /etc/modules-load.d/r36max2.conf), and r36-fwswap already proves rmmod/modprobe works on
# this board - at boot, with nothing holding the interface.  At runtime the supplicant is
# that holder, so it has to be stopped first or rmmod returns "Module is in use" and the
# reset silently does nothing.
#
# NOT YET MEASURED as a cure for the association wedge: it was written from the journal
# evidence on 2026-10-10 and has to be run on the device before it can be called a fix.
# It is bounded to one attempt per call and it only ever runs where the link is already
# down, so the worst case is the twenty seconds it takes.
# The USB device the chip hangs off, found by walking up from the netdev until the
# `authorized` attribute appears.  Hard-coded bus ids would be wrong the moment the topology
# changes; /sys/class/net/wlan0 is the only stable name on this board.
usb_dev_path() {
    p=$(readlink -f "/sys/class/net/$IFACE/device" 2>/dev/null)
    [ -n "$p" ] || return 1
    while [ -n "$p" ] && [ "$p" != "/" ]; do
        [ -e "$p/authorized" ] && { printf '%s' "$p"; return 0; }
        p=$(dirname "$p")
    done
    return 1
}

# The one recovery that is not "open the case": de-authorize and re-authorize the port,
# which forces the chip off and back onto the bus.  It is in this function because the
# module reload is NOT it - measured on the device 2026-10-12 07:57:11, the rmmod did run
# (`aicwf_usb_exit` + `usb_deregister` are in the kernel log), and it changed nothing: the
# boot produced exactly ONE "new high-speed USB device" line, at power-on, so modprobe
# re-bound a fresh driver to a chip that was still stuck mid-scan refusing every scan with
# -EBUSY.  Re-authorizing makes the driver probe the device again from scratch, which is
# what the firmware-upload lines at 07:53:24 are the signature of.
#
# Still unproven as a cure - it has never been run, because until tonight nothing in the
# stack ever attempted any recovery at all.  Bounded to one pass, and it only ever fires
# where the link is already down.
usb_replug() {
    p=$(usb_dev_path)
    [ -n "$p" ] || { audit "no USB device above $IFACE - cannot replug it"; return 1; }

    # A netdev that survives the toggle would mean the device was never detached, i.e. the
    # whole operation was a no-op - so the check before and after is the actual result.
    gone=0
    echo 0 >"$p/authorized" 2>/dev/null || { audit "writing authorized=0 was refused"; return 1; }
    sleep 2
    ip link show "$IFACE" >/dev/null 2>&1 || gone=1
    echo 1 >"$p/authorized" 2>/dev/null || { audit "writing authorized=1 was refused"; return 1; }

    i=0
    while [ $i -lt 25 ]; do
        ip link show "$IFACE" >/dev/null 2>&1 && break
        sleep 1
        i=$((i + 1))
    done
    audit "usb replug on $(basename "$p"): netdev disappeared=$gone reappeared=$(ip link show "$IFACE" >/dev/null 2>&1 && echo yes || echo no) after ${i}s"
    ip link show "$IFACE" >/dev/null 2>&1
}

driver_reset() {
    systemctl stop "$SVC" 2>/dev/null
    ip link set "$IFACE" down 2>/dev/null

    if usb_replug; then
        audit "chip reset: replugged over USB"
    else
        audit "chip reset: USB replug did not bring $IFACE back, reloading the modules instead"
        rmmod aic8800_fdrv 2>/dev/null
        rmmod aic_load_fw 2>/dev/null
        modprobe aic_load_fw 2>/dev/null
        modprobe aic8800_fdrv 2>/dev/null
        i=0
        while [ $i -lt 20 ]; do
            ip link show "$IFACE" >/dev/null 2>&1 && break
            sleep 1
            i=$((i + 1))
        done
    fi

    ip link show "$IFACE" >/dev/null 2>&1 || { audit "reset: $IFACE never came back"; err "wlan0 never came back after the reset"; return 1; }
    ip link set "$IFACE" up 2>/dev/null

    start_supplicant || return 1
    i=0
    while [ $i -lt 40 ]; do
        [ "$(wpa_state)" = COMPLETED ] && break
        sleep 1
        i=$((i + 1))
    done
    if [ "$(wpa_state)" = COMPLETED ]; then
        audit "reset: link restored, on \"$(wpa_ssid)\""
        echo "wifictl: driver reset worked, back on \"$(wpa_ssid)\"" >&2
        ensure_lease || true
        return 0
    fi
    audit "reset: still $(wpa_state) after 40s"
    err "driver reset did not restore the link ($(wpa_state)); this chip needs a power cycle"
    return 1
}

# Put the pre-attempt state back.  This is the path that decides whether a failed attempt
# costs the user their working connection, so it is written around what was actually
# measured on this chip, not around what wpa_supplicant normally needs:
#
#   * the block the attempt added is removed from the RUNNING daemon (`remove_network`),
#     because leaving it there makes the daemon retry that network forever - that is the whole
#     reason the first version of this function was wrong.
#   * the file is only restored if it was ever touched.  Since 2026-10-12 the attempt is built
#     with add_network and the file is written only after a connection that already worked, so
#     in the normal failure path there is nothing in the file to undo; the copy back is a
#     no-op kept for the paths that do write.
#   * nothing here re-reads the configuration any more, and that is deliberate: the one time
#     this function ended with a reload plus an unconditional reassociate, it printed
#     "back on … (COMPLETED)" and then destroyed that association 14 seconds later, and the
#     chip spent the rest of the boot refusing scans (see driver_reset).
#   * if the link did not come back on its own, reset the driver. Without that the board
#     stays offline until someone opens it - which is what happened on 2026-10-10: the
#     journal shows one association rejected by the driver at 14:42:16, then 34
#     "Association request to the driver failed" in the same boot, over 86 minutes, with
#     ZERO restarts of the supplicant. Waiting longer does not help; nothing in the
#     software stack had been asked to reset the chip.
restore_snapshot() {  # $1 = the ssid whose block was just added and has to go
    audit "rolling back to the configuration from before the attempt"

    id=$(network_id_for "$1")
    [ -n "$id" ] && $CTL remove_network "$id" >/dev/null 2>&1
    cp -a "$SNAP" "$CONF" 2>/dev/null
    chmod 600 "$CONF" 2>/dev/null

    # Do not touch a link that is already up.  This is a correction, taken from the box's own
    # journal: the version before this one ended with an unconditional enable-everything loop
    # plus reassociate, and at 07:55:36 that printed `back on "360JDCWiFi-E378" (COMPLETED)`
    # and then one second later destroyed that same association - "Trying to associate with
    # c8:5b…", "Authentication with c8:5b… timed out", "CTRL-EVENT-DISCONNECTED reason=3
    # locally_generated=1", then "CTRL-EVENT-SCAN-FAILED ret=-16" until the power was cut.
    # A rollback that re-breaks the connection is worse than no rollback.
    if [ "$(wpa_state)" = COMPLETED ]; then
        audit "rollback left the live association alone: on \"$(wpa_ssid)\""
        echo "wifictl: back on \"$(wpa_ssid)\" ($(wpa_state))" >&2
        return 0
    fi

    # Still down, so name the network to go back to: the id the daemon itself reported
    # before the attempt.  Not `reassociate` (that lets the daemon choose among blocks that
    # select_network has disabled) and not enable-everything (which is what cost us the link
    # above).  Removing the attempted block does not re-enable the others either - that is
    # why this has to be explicit.
    if [ -n "${was_id:-}" ]; then
        $CTL enable_network "$was_id" >/dev/null 2>&1
        $CTL select_network "$was_id" >/dev/null 2>&1
        audit "rollback: asked for the previous network id=$was_id"
    else
        $CTL reassociate >/dev/null 2>&1
        audit "rollback: no previous network id was known, fell back to reassociate"
    fi

    i=0
    while [ $i -lt 25 ]; do
        [ "$(wpa_state)" = COMPLETED ] && break
        sleep 1
        i=$((i + 1))
    done
    if [ "$(wpa_state)" = COMPLETED ]; then
        audit "rollback recovered the link: on \"$(wpa_ssid)\""
        echo "wifictl: back on \"$(wpa_ssid)\" ($(wpa_state))" >&2
        return 0
    fi

    audit "rollback did not restore the link ($(wpa_state)); resetting the chip"
    driver_reset
}

cmd_connect_saved() {  # $1 = ssid already present in $CONF
    ssid=${1:-}
    [ -n "$ssid" ] || { err "connect_saved: empty SSID"; return 1; }
    start_supplicant || return 1

    id=$(network_id_for "$ssid")
    if [ -z "$id" ]; then
        # Saved in the file but not loaded (added while the supplicant was down, or by an
        # edit that never reached the daemon).  The command is `reconfigure` - which is what
        # this card's wpa_cli actually has; `reload_config`, used here until 2026-10-12, is
        # not a command at all and answered "Unknown command" every time, invisibly, because
        # the reply was thrown away.  Keep the reply and say what it was.
        rc=$($CTL reconfigure 2>&1)
        audit "connect_saved: reconfigure said [$rc] for \"$ssid\""
        sleep 2
        id=$(network_id_for "$ssid")
    fi
    [ -n "$id" ] || { err "connect_saved: \"$ssid\" is not saved"; return 1; }

    # select_network is the whole request: it disconnects from anything else and joins this
    # network.  The extra `reassociate` that used to follow it was a second disconnect on top
    # of the first, measured on this chip as the difference between "rejoined" and "stuck".
    $CTL enable_network "$id" >/dev/null 2>&1
    sel=$($CTL select_network "$id" 2>&1)
    audit "connect_saved: id=$id select_network=[$sel] state=$(wpa_state)"
    [ "$sel" = FAIL ] && { err "connect_saved: select_network refused ([$sel])"; return 1; }

    connected_ok "$ssid" || return 1
}

cmd_forget_saved() {  # $1 = ssid
    ssid=${1:-}
    [ -n "$ssid" ] || { err "forget_saved: empty SSID"; return 1; }
    [ -r "$CONF" ] || return 0
    c=$(current_country)
    [ -n "$c" ] || c=$COUNTRY_DEFAULT

    # Drop it from the daemon first, then from the file - and do NOT restart the service.
    # A restart was the first version here, and measured on the card it left the board
    # showing "Not connected" for several seconds after a forget that had nothing to do
    # with the network it was using. remove_network is immediate and per-network; the file
    # only matters at the next start, which is exactly when it must be gone.
    id=$(network_id_for "$ssid")
    [ -n "$id" ] && $CTL remove_network "$id" >/dev/null 2>&1

    remove_network "$ssid" "$c" || return 1
}

cmd_enable() {  # optional $1 = ssid, $2 = psk, $3 = country
    # ES's ENABLE WI-FI row calls this with no arguments; the connect flow that follows it
    # then calls `connect` with the credentials.
    rfkill unblock wlan 2>/dev/null
    start_supplicant || return 1
    [ "$#" -ge 2 ] || return 0
    cmd_connect "$1" "$2" "${3:-}"
}

cmd_disable() {
    systemctl stop "$SVC" 2>/dev/null
    rfkill block wlan 2>/dev/null
}

case "${1:-}" in
    list)          cmd_list ;;
    scanlist)      cmd_scanlist ;;
    list_saved)    cmd_list_saved ;;
    connect)       shift; cmd_connect "$@" ;;
    connect_saved) shift; cmd_connect_saved "$@" ;;
    forget_saved)  shift; cmd_forget_saved "$@" ;;
    enable)        shift; cmd_enable "$@" ;;
    disable)       cmd_disable ;;
    recover)
        # Not one of the ten subcommands ES calls - this is the operator's lever, for the one
        # failure this chip produces that ES cannot show: after a refused association the
        # driver takes every later attempt with it, including the network that worked all
        # day. restore_snapshot reaches the same code by itself; this exists so it can be
        # run deliberately, over SSH or from a script, without having to fail a connect
        # first to get there.
        driver_reset ;;
    channels)
        # Nothing in this fork reaches it - getAvailableChannels() has no caller in es-app -
        # so it stays an empty success instead of inventing a list nobody consumes.
        ;;
    has_ap_mode)
        # Deliberately false. Exiting 0 makes ES add its LOCAL PLAY MODE / ad-hoc switches
        # (GuiMenu.cpp:5570), and ad-hoc play is not implemented on this image. The chip does
        # advertise AP mode in `iw phy phy0 info`, which is a different thing from what that
        # switch turns on.
        exit 1 ;;
    "")
        err "usage: wifictl {list|scanlist|list_saved|connect <ssid> <psk> <country>|connect_saved <ssid>|forget_saved <ssid>|enable [ssid psk country]|disable|recover|has_ap_mode|channels}"
        exit 2 ;;
    *)
        err "unknown subcommand: $1"
        exit 2 ;;
esac
