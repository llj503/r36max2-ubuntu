# Trimmed for the r36max2 build framework: single arch, no addons, no 32-bit split.

set -e

# setup initial directories (relative to root)
  CONFIG=config
  SCRIPTS=scripts
  PACKAGES=packages
  SOURCES=${SOURCES_DIR:-$ROOT/sources}
  BUILD_ROOT=${BUILD_DIR:-$ROOT}
  BUILD_BASE=build
  TARGET_IMG=${TARGET_DIR:-$ROOT/target}

[ -z "${HOST_NAME}" ] && export HOST_NAME="$($LOCAL_CC -dumpmachine)"
TARGET_NAME=$TARGET_GCC_ARCH-r36max2-linux-gnu${TARGET_ABI}

BUILD=${BUILD_ROOT}/${BUILD_BASE}.${DISTRO}-${PROJECT}.${TARGET_ARCH}

if [ -n "$BUILD_SUFFIX" ]; then
  BUILD=$BUILD-$BUILD_SUFFIX
fi

TARGET_IMG_DIR="$TARGET_IMG"
STAMPS=$BUILD/.stamps
DOCS=DOCS
TOOLCHAIN=$BUILD/toolchain
SYSROOT_PREFIX=$TOOLCHAIN/$TARGET_NAME/sysroot
LIB_PREFIX=$SYSROOT_PREFIX/usr
TARGET_PREFIX=$TOOLCHAIN/bin/$TARGET_NAME-
TARGET_KERNEL_PREFIX=$TARGET_PREFIX

# Host compiler wrappers. The rocknix framework creates these from the ccache
# package; we build no ccache, so alias the host gcc directly. The self-built
# cross toolchain lands in the same bin dir later.
mkdir -p "${TOOLCHAIN}/bin"
if [ ! -e "${TOOLCHAIN}/bin/host-gcc" ]; then
  ln -sf "$(command -v gcc)" "${TOOLCHAIN}/bin/host-gcc"
fi
if [ ! -e "${TOOLCHAIN}/bin/host-g++" ]; then
  ln -sf "$(command -v g++)" "${TOOLCHAIN}/bin/host-g++"
fi

if [ -z "$INSTALL" ]; then
  INSTALL=$BUILD/image/system
fi

. config/sources

MAKE="$TOOLCHAIN/bin/make"

. config/optimize

if [ -z "$CCACHE_DIR" ]; then
  export CCACHE_DIR=$BUILD/.ccache
fi
export BUILD_CCACHE_DIR="${CCACHE_DIR}"

if [[ -z "$PATH" || ( "$PATH" != "$TOOLCHAIN/bin:$TOOLCHAIN/sbin" && "$PATH" = "${PATH#$TOOLCHAIN/bin:$TOOLCHAIN/sbin:}" ) ]]; then
  export PATH="$TOOLCHAIN/bin:$TOOLCHAIN/sbin${PATH:+":$PATH"}"
fi

# redirect formatted output
export BUILD_INDENT_SIZE=4
SILENT_OUT=3
VERBOSE_OUT=4

if [ "$VERBOSE" = yes ]; then
  exec 3>&1
  exec 4>&1
else
  exec 3>&2
  exec 4>/dev/null
fi

unset LD_LIBRARY_PATH

# multilib? nah
unset CONFIG_SITE

# Ignore custom python installs...
unset PYTHONHOME PYTHONPATH PYTHONSTARTUP
export PYTHONNOUSERSITE=yes #disable PEP 370
unset PYTHONDONTWRITEBYTECODE
