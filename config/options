# Trimmed for the r36max2 build framework from ROCKNIX/distribution:
# addons/OEM/graphic config removed, Python/toolchain-cache lookups removed,
# deterministic SOURCE_DATE_EPOCH added.

# Do not build as root. Ever.
if [[ "${EUID}" -eq 0 ]]; then
  echo "Building as the root user is NOT supported. Use a regular user account for the build." 1>&2
  exit 1
fi

# Spaces in paths are verboten
if [[ ${PWD} =~ [[:space:]] ]]; then
  echo "Current PWD: \"${PWD}\"" 1>&2
  echo 1>&2
  echo "Building in a folder that includes spaces is NOT supported. Use a folder without spaces." 1>&2
  exit 1
fi

# set default language for buildsystem
export LC_ALL=C

# set default independent variables
ROOT="${PWD}"
DISTRO_DIR="${ROOT}/distributions"
PROJECT_DIR="${ROOT}/projects"

# determines DISTRO, if not forced by user
DISTRO="${DISTRO:-rk3326}"

# determines PROJECT, if not forced by user
export PROJECT="${PROJECT:-RK3326}"

# determines TARGET_ARCH, if not forced by user
export ARCH="${ARCH:-aarch64}"
TARGET_ARCH="${ARCH}"

# include helper functions
. config/functions

# read DISTRO version information
. "${DISTRO_DIR}/${DISTRO}/version" || die "\nERROR: No distro version present\n"

# read DISTRO options
if [ -f "${DISTRO_DIR}/${DISTRO}/options" ]; then
  . "${DISTRO_DIR}/${DISTRO}/options"
fi

# read PROJECT options
if [ -f "${PROJECT_DIR}/${PROJECT}/options" ]; then
  . "${PROJECT_DIR}/${PROJECT}/options"
fi

# read architecture defaults
if [ -f "config/arch.${TARGET_ARCH}" ]; then
  . "config/arch.${TARGET_ARCH}"
fi

# projects can set KERNEL_NAME (kernel.img)
KERNEL_NAME="${KERNEL_NAME:-KERNEL}"

LINUX_DEPENDS="${PROJECT_DIR}/${PROJECT}/linux ${PROJECT_DIR}/${PROJECT}/patches/linux ${PROJECT_DIR}/${PROJECT}/packages/linux ${ROOT}/packages/linux"

# Need to point to your actual cc
# If you have ccache installed, take care that LOCAL_CC does not point to it
[ -z "${LOCAL_CC}" ] && export LOCAL_CC="$(command -v gcc)"

if [ -z "${LOCAL_CC}" ]; then
  die "***** Please install gcc - run scripts/checkdeps *****" "127"
fi

# Need to point to your actual g++
[ -z "${LOCAL_CXX}" ] && export LOCAL_CXX="$(command -v g++)"

# verbose compilation mode (yes/no)
VERBOSE="${VERBOSE:-no}"

# Concurrency make level (-j option)
#  Try values between 1 and number of processor cores present.
#  default: use all cores
[ -z "${CONCURRENCY_MAKE_LEVEL}" ] && export CONCURRENCY_MAKE_LEVEL=$(nproc)
[ -z "${CONCURRENCY_LOAD}" ] && export CONCURRENCY_LOAD=0

# ---------------------------------------------------------------------------
# Deterministic build timestamp. Every build of the same tree gets the same
# SOURCE_DATE_EPOCH: the commit timestamp of HEAD (overridable for local
# experiments with R36_SOURCE_DATE_EPOCH). The kernel embeds it via
# KBUILD_BUILD_*; mkimage clamps filesystem timestamps to it.
# ---------------------------------------------------------------------------
if [ -z "${SOURCE_DATE_EPOCH}" ]; then
  if [ -n "${R36_SOURCE_DATE_EPOCH}" ]; then
    SOURCE_DATE_EPOCH="${R36_SOURCE_DATE_EPOCH}"
  elif [ -d "${ROOT}/.git" ]; then
    SOURCE_DATE_EPOCH="$(git -C "${ROOT}" log -1 --format=%ct 2>/dev/null)" || SOURCE_DATE_EPOCH=""
  fi
  [ -z "${SOURCE_DATE_EPOCH}" ] && die "ERROR: cannot determine SOURCE_DATE_EPOCH (not a git tree and R36_SOURCE_DATE_EPOCH unset)"
fi
export SOURCE_DATE_EPOCH
export KBUILD_BUILD_TIMESTAMP="@${SOURCE_DATE_EPOCH}"
export KBUILD_BUILD_USER=r36max2
export KBUILD_BUILD_HOST=r36max2

# read local persistent options from $ROOT if available
if [ -f "${ROOT}/.r36max2/options" ]; then
  . "${ROOT}/.r36max2/options"
fi

# read global persistent options from $HOME if available
if [ -f "${HOME}/.r36max2/options" ]; then
  . "${HOME}/.r36max2/options"
fi

# use /bin/dash as config shell if installed on the build host
if [ -z "${CONFIG_SHELL}" ] && [ -x "/bin/dash" ]; then
  export CONFIG_SHELL="/bin/dash"
fi

check_config

. config/path $1

## package processing

# If the package caches are unset, then populate them
init_package_cache

# set package metadata
source_package "${1}"
